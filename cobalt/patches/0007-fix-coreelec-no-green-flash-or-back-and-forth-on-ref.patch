+#include <chrono>
 #include <functional>
 #include <memory>
 #include <optional>
@@ -70,17 +71,34 @@ std::optional<ModeSwitch> ChooseModeSwitch(const std::string& allowed,
 // Auto frame rate across videos: remembers the mode it first switched away from.
 class AutoFrameRate {
  public:
-  // The switch for |frame_rate| (see ChooseModeSwitch). A |frame_rate| of 0 or
-  // less means no video wants a rate: back to the mode before the first switch.
+  using Clock = std::chrono::steady_clock;
+  // How long the display keeps a video's rate once no video wants one: the next
+  // video usually wants the same rate, and each switch blanks the TV.
+  static constexpr std::chrono::seconds kRestoreDelay{5};
+
+  // The switch for |frame_rate| (see ChooseModeSwitch); it cancels a pending
+  // return. A |frame_rate| of 0 or less means no video wants a rate: the return
+  // to the mode before the first switch is due kRestoreDelay after |now|.
   std::optional<ModeSwitch> Choose(const std::string& allowed,
                                    const std::string& current,
                                    bool current_fractional,
                                    const std::string& display_caps,
                                    double frame_rate,
+                                   Clock::time_point now,
                                    std::string* why = nullptr);
 
+  // When the return is due; empty when none is pending.
+  std::optional<Clock::time_point> restore_time() const { return restore_at_; }
+
+  // The return to the original mode, once |now| reaches restore_time(). Empty
+  // when it is not due, or the display already shows the original mode.
+  std::optional<ModeSwitch> Restore(const std::string& current,
+                                    bool current_fractional,
+                                    Clock::time_point now);
+
  private:
   std::optional<ModeSwitch> original_;
+  std::optional<Clock::time_point> restore_at_;
 };
 
