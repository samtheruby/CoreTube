+// disp_cap's name for a progressive |width|x|height| mode at |rate| whole Hz.
+std::optional<std::string> DisplayName(const std::string& display_caps,
+                                       int width,
+                                       int height,
+                                       int rate) {
+  std::istringstream lines(display_caps);
+  for (std::string line; std::getline(lines, line);) {
+    line.erase(line.find_last_not_of(" *\t\r") + 1);
+    auto mode = ParseMode(line);
+    if (mode && !mode->interlaced && mode->suffix.empty() && mode->width == width &&
+        mode->height == height && mode->rate == rate) {
+      return line;
+    }
+  }
+  return {};
+}
+
+// The page is drawn at the framebuffer's size and fb0's scaler stretches it to
+// the screen (tizentube-start sets it up). After a switch to another resolution,
+// point the scaler at the new size, in the order Kodi's aml_enable_freeScale uses.
+void ScaleFramebufferTo(int width, int height) {
+  if (width <= 0 || height <= 0 || ReadFile(kFreeScalePath).empty()) {
+    return;
+  }
+  WriteFile(kFreeScalePath, "0");
+  WriteFile(kWindowAxisPath,
+            "0 0 " + std::to_string(width - 1) + " " + std::to_string(height - 1));
+  WriteFile(kFreeScalePath, "0x10001");
+}
