@@ -12,6 +12,7 @@
 //   a seek), instead of playing a second and stalling again.
 // Home screen video previews are off unless the add-on turns them on: a preview
 // starting can flash the screen white for a moment (cause unknown).
+// TizenTube's auto frame rate also tells Cobalt the video's best resolution.
 (function () {
   'use strict';
   if (window.__coretubeSabr || !/(^|\.)youtube\.com$/.test(location.hostname)) return;
@@ -56,6 +57,31 @@
   };
   setPreviewFlag();
 
+  // --- Auto frame rate: the video's resolution too --------------------------
+  // TizenTube passes only the frame rate. Add the height of the best quality
+  // YouTube can play for this video (0 when unknown), so Cobalt can also switch
+  // the display to that resolution when Kodi's whitelist has it.
+  var bestVideoHeight = function () {
+    try {
+      var player = document.querySelector('.html5-video-player');
+      var qualities = (player && player.getAvailableQualityData && player.getAvailableQualityData()) || [];
+      return qualities.reduce(function (best, q) {
+        return q.isPlayable === false ? best : Math.max(best, parseInt(q.qualityLabel, 10) || 0);
+      }, 0);
+    } catch (e) {
+      log('cannot read the video qualities: ' + e);
+      return 0;
+    }
+  };
+  var tizentube = window.h5vcc && window.h5vcc.tizentube;
+  var tizentubeApi = tizentube && Object.getPrototypeOf(tizentube);
+  if (tizentubeApi && typeof tizentubeApi.SetFrameRate === 'function') {
+    var origSetFrameRate = tizentubeApi.SetFrameRate;
+    tizentubeApi.SetFrameRate = function (frameRate) {
+      return origSetFrameRate.call(this, frameRate, frameRate > 0 ? bestVideoHeight() : 0);
+    };
+  }
+
   // --- Keep slow downloads alive -------------------------------------------
   var downloads = new WeakMap();  // AbortSignal -> {start, last, done}
   var origFetch = window.fetch;
