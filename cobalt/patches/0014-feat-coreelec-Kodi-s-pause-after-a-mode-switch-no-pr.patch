+// Playback after a mode switch, as with Kodi's "Delay after change of refresh
+// rate": players hold their video for SwitchHold() after each switch, so the TV
+// has settled and nothing plays unseen. |delay_ms| is the add-on's
+// TIZENTUBE_SWITCH_DELAY_MS (Kodi's delay); the hold lasts at least while HDMI
+// is muted after the switch, and at most Kodi's longest delay (20 s).
+std::chrono::milliseconds SwitchHold(const char* delay_ms);
+// Holds playback until |until|, and tells the listener.
+void HoldPlayback(AutoFrameRate::Clock::time_point until);
+// Ends the hold once |now| reaches its end, and tells the listener. True when
+// it ended.
+bool EndPlaybackHold(AutoFrameRate::Clock::time_point now);
+std::optional<AutoFrameRate::Clock::time_point> PlaybackHoldEnd();
+bool PlaybackHeld(AutoFrameRate::Clock::time_point now = AutoFrameRate::Clock::now());
+// Told when a hold starts or ends: players pause, or play on. Any thread; it
+// must not block.
+void SetPlaybackHoldListener(std::function<void()> listener);
