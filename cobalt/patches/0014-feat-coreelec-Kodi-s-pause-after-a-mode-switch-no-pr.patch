+void PlayerImpl::PlaybackHoldChanged() {
+#if defined(COREELEC)
+  DispatchOnWorkerThread(new FunctionTask([this]() {
+    if (::third_party::starboard::rdk::shared::coreelec::PlaybackHeld()) {
+      GstState state = GST_STATE_VOID_PENDING, pending = GST_STATE_VOID_PENDING;
+      gst_element_get_state(pipeline_, &state, &pending, 0);
+      if (state == GST_STATE_PLAYING || pending == GST_STATE_PLAYING) {
+        held_for_switch_ = true;
+        GST_INFO_OBJECT(pipeline_, "Holding playback after a display mode switch");
+        ChangePipelineState(GST_STATE_PAUSED);
