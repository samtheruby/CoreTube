+namespace {
+std::mutex g_hold_mutex;
+std::optional<AutoFrameRate::Clock::time_point> g_hold_until;
+std::function<void()> g_hold_listener;
+
+void TellHoldListener() {
+  std::function<void()> listener;
+  {
+    std::lock_guard<std::mutex> lock(g_hold_mutex);
+    listener = g_hold_listener;
+  }
+  if (listener) {
+    listener();
+  }
+}
+}  // namespace
+
+std::chrono::milliseconds SwitchHold(const char* delay_ms) {
+  constexpr long kLongestMs = 20000;
+  long delay = 0;
+  if (delay_ms) {
+    char* end = nullptr;
+    const long value = strtol(delay_ms, &end, 10);
+    if (end != delay_ms && *end == '\0' && value > 0) {
+      delay = std::min(value, kLongestMs);
+    }
+  }
+  return std::max(std::chrono::milliseconds(delay),
+                  std::chrono::duration_cast<std::chrono::milliseconds>(kSwitchMute));
+}
+
+void HoldPlayback(AutoFrameRate::Clock::time_point until) {
+  {
+    std::lock_guard<std::mutex> lock(g_hold_mutex);
+    g_hold_until = until;
+  }
+  TellHoldListener();
+}
+
+bool EndPlaybackHold(AutoFrameRate::Clock::time_point now) {
+  {
+    std::lock_guard<std::mutex> lock(g_hold_mutex);
+    if (!g_hold_until || now < *g_hold_until) {
+      return false;
+    }
+    g_hold_until.reset();
+  }
+  TellHoldListener();
+  return true;
+}
+
+std::optional<AutoFrameRate::Clock::time_point> PlaybackHoldEnd() {
+  std::lock_guard<std::mutex> lock(g_hold_mutex);
+  return g_hold_until;
+}
+
+bool PlaybackHeld(AutoFrameRate::Clock::time_point now) {
+  std::lock_guard<std::mutex> lock(g_hold_mutex);
+  return g_hold_until && now < *g_hold_until;
+}
+
+void SetPlaybackHoldListener(std::function<void()> listener) {
+  std::lock_guard<std::mutex> lock(g_hold_mutex);
+  g_hold_listener = std::move(listener);
+}
