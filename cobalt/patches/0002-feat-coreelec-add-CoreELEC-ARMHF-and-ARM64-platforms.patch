+// Copyright 2026 Team CoreELEC (https://coreelec.org)
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Audio passthrough on CoreELEC: AC3 and E-AC3 go to the HDMI (or S/PDIF)
+// output as a bitstream, as Kodi sends them, when Kodi's passthrough settings
+// allow it. The add-on's tizentube-start passes those settings on:
+//   TIZENTUBE_PASSTHROUGH         codecs to pass through, e.g. "ac3 eac3"
+//   TIZENTUBE_PASSTHROUGH_DEVICE  ALSA device base name, "hdmi" or "iec958"
+
+#ifndef THIRD_PARTY_STARBOARD_RDK_SHARED_COREELEC_AUDIO_H_
+#define THIRD_PARTY_STARBOARD_RDK_SHARED_COREELEC_AUDIO_H_
+
+#include <string>
+
+typedef struct _GstElement GstElement;
+
+namespace third_party::starboard::rdk::shared::coreelec {
+
+enum class Bitstream { kNone, kAc3, kEac3 };
+
+// The bitstream |list| (TIZENTUBE_PASSTHROUGH) allows for |codec| ("ac3", "eac3").
+Bitstream PassthroughFor(const std::string& list, const std::string& codec);
+
+// The item of the Amlogic "Audio spdif format" mixer control for |bitstream|,
+// as Kodi's CAESinkALSA sets it: 0 "2 CH PCM", 2 "Dolby Digital", 4 "Dolby Digital Plus".
+int SpdifFormatItem(Bitstream bitstream);
+
+// For a codec the user passes through: an alsasink on the passthrough device,
+// with the output switched to that bitstream. nullptr otherwise. |codec| as above.
+GstElement* CreatePassthroughSink(const std::string& codec);
+
+// Called when a player that got a passthrough sink ends: the output goes back
+// to PCM once no passthrough player is left.
+void ReleasePassthrough();
+
+}  // namespace third_party::starboard::rdk::shared::coreelec
+
+#endif  // THIRD_PARTY_STARBOARD_RDK_SHARED_COREELEC_AUDIO_H_
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc
