@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Host test for coreelec_audio.cc: which codecs pass through, and the Amlogic
+// "Audio spdif format" mixer item for each.
+#include "third_party/starboard/rdk/shared/coreelec_audio.h"
+
+#include <cassert>
+#include <iostream>
+
+using namespace third_party::starboard::rdk::shared::coreelec;
+
+int main() {
+  // TIZENTUBE_PASSTHROUGH lists the codecs Kodi passes through.
+  assert(PassthroughFor("ac3 eac3", "eac3") == Bitstream::kEac3);
+  assert(PassthroughFor("ac3 eac3", "ac3") == Bitstream::kAc3);
+  assert(PassthroughFor("ac3", "eac3") == Bitstream::kNone);
+  assert(PassthroughFor("eac3", "ac3") == Bitstream::kNone);
+  assert(PassthroughFor("", "ac3") == Bitstream::kNone);
+  assert(PassthroughFor("ac3 eac3", "opus") == Bitstream::kNone);
+  assert(PassthroughFor("  eac3  ac3 ", "eac3") == Bitstream::kEac3);
+  assert(PassthroughFor("xeac3", "eac3") == Bitstream::kNone);  // whole words only
+
+  // Items as the AML-AUGESOUND card lists them (amixer cget 'Audio spdif_b format').
+  assert(SpdifFormatItem(Bitstream::kNone) == 0);  // 2 CH PCM
+  assert(SpdifFormatItem(Bitstream::kAc3) == 2);   // Dolby Digital
+  assert(SpdifFormatItem(Bitstream::kEac3) == 4);  // Dolby Digital Plus
+
+  std::cout << "coreelec_audio tests passed\n";
+  return 0;
+}
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
new file mode 100644
index 00000000000..66e9bbca4e2
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Host test for coreelec_display.cc: mode names, allowed modes, refresh rate choice.
+#include "third_party/starboard/rdk/shared/coreelec_display.h"
+
+#include <cassert>
+#include <cmath>
+#include <iostream>
+
+using namespace third_party::starboard::rdk::shared::coreelec;
+
+int main() {
+  auto m = ParseMode("2160p60hz");
+  assert(m && m->width == 3840 && m->height == 2160 && m->rate == 60 && !m->interlaced);
+  assert(m->prefix == "2160p" && m->suffix.empty());
+  m = ParseMode("1080i50hz");
+  assert(m && m->width == 1920 && m->interlaced && m->prefix == "1080i");
+  m = ParseMode("smpte24hz");
+  assert(m && m->width == 4096 && m->height == 2160 && m->prefix == "smpte");
+  m = ParseMode("640x480p60hz");
+  assert(m && m->width == 640 && m->height == 480 && m->prefix == "640x480p");
+  m = ParseMode("576p50hz");
+  assert(m && m->width == 720);
+  m = ParseMode("2160p50hz420");
+  assert(m && m->rate == 50 && m->suffix == "420");
+  assert(!ParseMode("") && !ParseMode("invalid"));
+
+  auto allowed = ParseAllowedModes(
+      "3840x2160@60 3840x2160@59.94 3840x2160@50 3840x2160@24 3840x2160@23.976 "
+      "1920x1080@30 junk 3840x2160@0");
+  assert(allowed.size() == 6);
+  auto near = [](double a, double b) { return std::fabs(a - b) < 1e-6; };
+  assert(near(ChooseRefreshRate(allowed, 3840, 2160, 24), 24));         // exact
+  assert(near(ChooseRefreshRate(allowed, 3840, 2160, 23.976), 23.976)); // exact fractional
+  assert(near(ChooseRefreshRate(allowed, 3840, 2160, 25), 50));         // 2x multiple
+  assert(near(ChooseRefreshRate(allowed, 3840, 2160, 29.97), 59.94));   // 2x fractional
+  assert(near(ChooseRefreshRate(allowed, 3840, 2160, 30), 60));
+  assert(ChooseRefreshRate(allowed, 3840, 2160, 0) == 0);
+  assert(ChooseRefreshRate(allowed, 1920, 1080, 24) == 0);              // only 30 Hz at 1080p
+  // 24 fps without a 24 Hz mode falls back to 23.976 (0.1% off), not to 60.
+  auto no24 = ParseAllowedModes("3840x2160@23.976 3840x2160@60");
+  assert(near(ChooseRefreshRate(no24, 3840, 2160, 24), 23.976));
+  std::cout << "all display tests passed\n";
+  return 0;
+}
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/gbm_smoke_test.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/gbm_smoke_test.cc
new file mode 100644
index 00000000000..6585c650b1b
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/gbm_smoke_test.cc
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "../../shared/coreelec_gbm.h"
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES2/gl2.h>
+#include <cstdio>
+
+int main() {
+  CoreelecGbm window;
+  if (!window.Open())
+    return 1;
+  auto platform_display = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(
+      eglGetProcAddress("eglGetPlatformDisplayEXT"));
+  if (!platform_display)
+    return 2;
+  EGLDisplay display =
+      platform_display(EGL_PLATFORM_GBM_KHR, window.device(), nullptr);
+  EGLint major, minor, count;
+  if (!eglInitialize(display, &major, &minor) || !eglBindAPI(EGL_OPENGL_ES_API))
+    return 3;
+  const EGLint attributes[] = {EGL_SURFACE_TYPE,
+                               EGL_WINDOW_BIT,
+                               EGL_RENDERABLE_TYPE,
+                               EGL_OPENGL_ES2_BIT,
+                               EGL_RED_SIZE,
+                               8,
+                               EGL_GREEN_SIZE,
+                               8,
+                               EGL_BLUE_SIZE,
+                               8,
+                               EGL_ALPHA_SIZE,
+                               8,
+                               EGL_NONE};
+  EGLConfig config;
+  if (!eglChooseConfig(display, attributes, &config, 1, &count) || count != 1)
+    return 4;
+  const EGLint context_attributes[] = {EGL_CONTEXT_CLIENT_VERSION, 2, EGL_NONE};
+  EGLContext context =
+      eglCreateContext(display, config, EGL_NO_CONTEXT, context_attributes);
+  EGLSurface surface = eglCreateWindowSurface(
+      display, config, reinterpret_cast<EGLNativeWindowType>(window.surface()),
+      nullptr);
+  if (context == EGL_NO_CONTEXT || surface == EGL_NO_SURFACE ||
+      !eglMakeCurrent(display, surface, surface, context))
+    return 5;
+  // Cobalt initializes EGL before its window requests the same GBM device.
+  if (!window.Open())
+    return 5;
+  for (int i = 0; i < 6; ++i) {
+    glClearColor(i % 3 == 0, i % 3 == 1, i % 3 == 2, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    if (!eglSwapBuffers(display, surface))
+      return 6;
+    glFinish();
+    if (!window.Present())
+      return 7;
+  }
+  eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+  eglDestroySurface(display, surface);
+  eglDestroyContext(display, context);
+  eglTerminate(display);
+  printf("gbm-smoke: presented 6 frames at %dx%d\n", window.width(),
+         window.height());
+}
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/run_host_tests.sh b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/run_host_tests.sh
