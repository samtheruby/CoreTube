index 00000000000..0733670d05d
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc
@@ -0,0 +1,268 @@
+// Copyright 2026 Team CoreELEC (https://coreelec.org)
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "third_party/starboard/rdk/shared/coreelec_display.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <regex>
+#include <sstream>
+
+#include "starboard/common/log.h"
+#include "starboard/extension/tizentube_display.h"
+
+namespace third_party::starboard::rdk::shared::coreelec {
+namespace {
+
+constexpr char kModePath[] = "/sys/class/display/mode";
+constexpr char kDisplayCapsPath[] = "/sys/class/amhdmitx/amhdmitx0/disp_cap";
+constexpr char kHdrCapsPath[] = "/sys/class/amhdmitx/amhdmitx0/hdr_cap";
+constexpr char kFracRatePath[] = "/sys/class/amhdmitx/amhdmitx0/frac_rate_policy";
+
+// The whole file, without trailing white space; empty when it cannot be read.
+std::string ReadFile(const char* path) {
+  std::ifstream file(path);
+  std::stringstream text;
+  text << file.rdbuf();
+  std::string value = text.str();
+  value.erase(value.find_last_not_of(" \t\r\n") + 1);
+  return value;
+}
+
+bool WriteFile(const char* path, const std::string& value) {
+  std::ofstream file(path);
+  file << value;
+  file.flush();
+  if (!file) {
+    SB_LOG(ERROR) << "Cannot write '" << value << "' to " << path;
+    return false;
+  }
+  return true;
+}
+
+double ActualRate(int rate, bool fractional) {
+  bool slowed = rate == 24 || rate == 30 || rate == 60 || rate == 120;
+  return fractional && slowed ? rate * 1000.0 / 1001.0 : rate;
+}
+
+// disp_cap lists the modes the TV takes, one per line, the current one marked "*".
+bool DisplayTakes(const std::string& name) {
+  std::istringstream lines(ReadFile(kDisplayCapsPath));
+  for (std::string line; std::getline(lines, line);) {
+    line.erase(line.find_last_not_of(" *\t\r") + 1);
+    if (line == name) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SetFrameRate(float frame_rate) {
+  if (!(frame_rate > 0)) {
+    return;
+  }
+  const char* allowed = getenv("TIZENTUBE_DISPLAY_MODES");
+  auto current = ParseMode(ReadFile(kModePath));
+  if (!allowed || !*allowed || !current || current->interlaced) {
+    SB_LOG(INFO) << "Auto frame rate: no display modes to switch to";
+    return;
+  }
+  double rate = ChooseRefreshRate(ParseAllowedModes(allowed), current->width,
+                                  current->height, frame_rate);
+  if (rate <= 0) {
+    SB_LOG(INFO) << "Auto frame rate: no allowed mode fits " << frame_rate
+                 << " fps at " << current->width << "x" << current->height;
+    return;
+  }
+
+  int whole = static_cast<int>(std::lround(rate));
+  bool fractional = std::fabs(rate - whole) > 0.01;
+  bool current_fractional = ReadFile(kFracRatePath) == "1";
+  if (std::fabs(ActualRate(whole, fractional) -
+                ActualRate(current->rate, current_fractional)) < 0.01) {
+    return;
+  }
+  std::string name = current->prefix + std::to_string(whole) + "hz";
+  if (!DisplayTakes(name)) {
+    SB_LOG(WARNING) << "Auto frame rate: the TV does not list " << name;
+    return;
+  }
+  SB_LOG(INFO) << "Auto frame rate: " << frame_rate << " fps, switching to "
+               << name << (fractional ? " (1000/1001)" : "");
+  if (WriteFile(kFracRatePath, fractional ? "1" : "0")) {
+    WriteFile(kModePath, name + current->suffix);
+  }
+}
+
+const TizenTubeExtensionDisplayApi kDisplayApi = {
+    kTizenTubeExtensionDisplayName,
+    1,
+    &SetFrameRate,
+};
+
+class CoreELECInterface final : public platform::PlatformInterface {
+  struct Device final : public platform::IDevice {
+    std::optional<platform::Resolution> video_resolution() override {
+      auto mode = ParseMode(ReadFile(kModePath));
+      if (!mode) {
+        return {};
+      }
+      int width = mode->width;
+      int height = mode->height;
+      // The add-on's "maximum video resolution" setting.
+      const char* max = getenv("TIZENTUBE_MAX_VIDEO_HEIGHT");
+      int max_height = max ? atoi(max) : 0;
+      if (max_height > 0 && height > max_height) {
+        width = width * max_height / height;
+        height = max_height;
+      }
+      return platform::Resolution(width, height);
+    }
+
+    std::optional<platform::HDRFormat> hdr() override {
+      std::string caps = ReadFile(kHdrCapsPath);
+      if (caps.empty()) {
+        return {};
+      }
+      platform::HDRFormat format;
+      format.hdr10 = caps.find("SMPTE ST 2084: 1") != std::string::npos;
+      format.hlg = caps.find("Hybrid Log-Gamma: 1") != std::string::npos;
+      // HDR10+ and Dolby Vision need dynamic metadata that amlvideosink does
+      // not pass on, so they stay off.
+      return format;
+    }
+
+    std::optional<float> diagonal_size_in_inches() override { return {}; }
+    std::optional<bool> audio_configuration(int, SbMediaAudioConfiguration*) override {
+      return {};
+    }
+    std::optional<std::string> brand_name() override { return {}; }
+    std::optional<std::string> chipset() override { return {}; }
+    std::optional<std::string> device_type() override { return {}; }
+    std::optional<std::string> firmware_version() override { return {}; }
+    std::optional<bool> is_connection_type_wireless() override { return {}; }
+    std::optional<bool> is_disconnected() override { return {}; }
+  };
+
+  struct NoTextToSpeech final : public platform::ITextToSpeech {
+    std::optional<bool> cancel() override { return {}; }
+    std::optional<bool> speak(const std::string&) override { return {}; }
+    std::optional<bool> is_available() override { return {}; }
+    std::optional<bool> is_enabled() override { return {}; }
+  };
+
+  struct NoAccessibility final : public platform::IAccessibility {
+    std::optional<bool> display_settings(SbAccessibilityDisplaySettings&) override {
+      return {};
+    }
+    std::optional<bool> caption_settings(SbAccessibilityCaptionSettings&) override {
+      return {};
+    }
+  };
+
+  struct NoAdvertising final : public platform::IAdvertising {
+    std::optional<platform::Ifa> advertising_id() override { return {}; }
+  };
+
+  Device device_;
+  NoTextToSpeech text_to_speech_;
+  NoAccessibility accessibility_;
+  NoAdvertising advertising_;
+
+ public:
+  void teardown() override {}
+  void suspend() override {}
+  void resume() override {}
+  platform::IDevice& device() override { return device_; }
+  platform::ITextToSpeech& text_to_speech() override { return text_to_speech_; }
+  platform::IAccessibility& accessibility() override { return accessibility_; }
+  platform::IAdvertising& advertising() override { return advertising_; }
+};
+
+}  // namespace
+
+std::optional<DisplayMode> ParseMode(const std::string& name) {
+  static const std::regex kSmpte("smpte(\\d+)hz(.*)");
+  static const std::regex kMode("(?:(\\d+)x)?(\\d+)([pi])(\\d+)hz(.*)");
+  std::smatch m;
+  DisplayMode mode;
+  if (std::regex_match(name, m, kSmpte)) {
+    mode.width = 4096;
+    mode.height = 2160;
+    mode.rate = std::stoi(m[1]);
+    mode.prefix = "smpte";
+    mode.suffix = m[2];
+    return mode;
+  }
+  if (!std::regex_match(name, m, kMode)) {
+    return {};
+  }
+  mode.height = std::stoi(m[2]);
+  mode.interlaced = m[3] == "i";
+  mode.rate = std::stoi(m[4]);
+  mode.prefix = std::string(m[1].matched ? m[1].str() + "x" : "") + m[2].str() + m[3].str();
+  mode.suffix = m[5];
+  if (m[1].matched) {
+    mode.width = std::stoi(m[1]);
+  } else if (mode.height == 576 || mode.height == 480) {
+    mode.width = 720;  // SD modes are 720 wide, not 16:9 square pixels
+  } else {
+    mode.width = mode.height * 16 / 9;
+  }
+  return mode;
+}
+
+std::vector<AllowedMode> ParseAllowedModes(const std::string& list) {
+  std::vector<AllowedMode> modes;
+  std::istringstream items(list);
+  for (std::string item; items >> item;) {
+    AllowedMode mode;
+    if (sscanf(item.c_str(), "%dx%d@%lf", &mode.width, &mode.height, &mode.rate) == 3 &&
+        mode.rate > 0) {
+      modes.push_back(mode);
+    }
+  }
+  return modes;
+}
+
+double ChooseRefreshRate(const std::vector<AllowedMode>& allowed,
+                         int width,
+                         int height,
+                         double frame_rate) {
+  constexpr double kMaxError = 0.002;  // 23.976 fits 24 fps, 25 does not
+  double best_rate = 0;
+  double best_error = 0;
+  long best_multiple = 0;
+  if (!(frame_rate > 0)) {
+    return 0;
+  }
+  for (const AllowedMode& mode : allowed) {
+    long multiple = std::lround(mode.rate / frame_rate);
+    if (mode.width != width || mode.height != height || multiple < 1) {
+      continue;
+    }
+    double error = std::fabs(mode.rate - multiple * frame_rate) / mode.rate;
+    if (error > kMaxError) {
+      continue;
+    }
+    if (best_rate == 0 || error < best_error - 1e-9 ||
+        (error < best_error + 1e-9 && multiple < best_multiple)) {
+      best_rate = mode.rate;
+      best_error = error;
+      best_multiple = multiple;
+    }
+  }
+  return best_rate;
+}
+
+std::unique_ptr<platform::PlatformInterface> CreatePlatformInterface() {
+  return std::make_unique<CoreELECInterface>();
+}
+
+const void* GetDisplayApi() {
+  return &kDisplayApi;
+}
+
+}  // namespace third_party::starboard::rdk::shared::coreelec
