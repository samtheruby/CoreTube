@@ -0,0 +1,59 @@
+// Copyright 2026 Team CoreELEC (https://coreelec.org)
+// SPDX-License-Identifier: BSD-3-Clause
+
+// The display on CoreELEC (Amlogic sysfs): what Cobalt may play on it, and
+// refresh rate switching for TizenTube's auto frame rate.
+
+#ifndef THIRD_PARTY_STARBOARD_RDK_SHARED_COREELEC_DISPLAY_H_
+#define THIRD_PARTY_STARBOARD_RDK_SHARED_COREELEC_DISPLAY_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "third_party/starboard/rdk/shared/platform/platform_interface.h"
+
+namespace third_party::starboard::rdk::shared::coreelec {
+
+// A display mode as /sys/class/display/mode names it: "2160p60hz", "smpte24hz",
+// "640x480p60hz". The name holds whole Hz; frac_rate_policy makes 24, 30, 60
+// and 120 Hz run 1000/1001 slower (23.976, 29.97, 59.94).
+struct DisplayMode {
+  int width = 0;
+  int height = 0;
+  int rate = 0;
+  bool interlaced = false;
+  std::string prefix;  // the name up to the rate: "2160p", "smpte", "640x480p"
+  std::string suffix;  // anything after "hz"
+};
+
+std::optional<DisplayMode> ParseMode(const std::string& name);
+
+// A mode the user lets TizenTube switch to: TIZENTUBE_DISPLAY_MODES holds them
+// as "WIDTHxHEIGHT@RATE" separated by spaces (written by the add-on's default.py).
+struct AllowedMode {
+  int width;
+  int height;
+  double rate;
+};
+
+std::vector<AllowedMode> ParseAllowedModes(const std::string& list);
+
+// The refresh rate among |allowed| modes of |width|x|height| that shows
+// |frame_rate| best: the closest whole multiple (within 0.2%), the lowest
+// multiple on a tie. 0 when none fits.
+double ChooseRefreshRate(const std::vector<AllowedMode>& allowed,
+                         int width,
+                         int height,
+                         double frame_rate);
+
+// Device and display properties for Cobalt (resolution, HDR).
+std::unique_ptr<platform::PlatformInterface> CreatePlatformInterface();
+
+// The TizenTubeExtensionDisplayApi Starboard extension.
+const void* GetDisplayApi();
+
+}  // namespace third_party::starboard::rdk::shared::coreelec
+
+#endif  // THIRD_PARTY_STARBOARD_RDK_SHARED_COREELEC_DISPLAY_H_
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_gbm.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_gbm.cc
