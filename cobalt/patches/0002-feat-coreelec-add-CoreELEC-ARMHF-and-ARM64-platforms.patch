+// SPDX-License-Identifier: BSD-3-Clause
+#ifndef COREELEC_GBM_H_
+#define COREELEC_GBM_H_
+
+#include <gbm.h>
+#include <map>
+#include <xf86drmMode.h>
+
+class CoreelecGbm {
+public:
+  CoreelecGbm() = default;
