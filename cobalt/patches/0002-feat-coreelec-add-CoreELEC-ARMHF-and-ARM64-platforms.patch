@@ -0,0 +1,17 @@
+#!/bin/sh
+# SPDX-License-Identifier: BSD-3-Clause
+# Host tests for the CoreELEC display and passthrough helpers.
+# Needs a C++17 compiler, pkg-config, ALSA and GStreamer development files.
+# Usage: run_host_tests.sh [OUT_DIR]
+set -eu
+tests=$(cd "$(dirname "$0")" && pwd)
+src=$(cd "$tests/../../../../.." && pwd)        # starboard/contrib/rdk/src
+repo=$(cd "$src/../../../.." && pwd)            # for starboard/extension/
+shared=$src/third_party/starboard/rdk/shared
+out=${1:-$(mktemp -d)}
+flags="-std=c++17 -Wall -Wextra -Werror -I$tests/stub -I$src -I$repo $(pkg-config --cflags gstreamer-1.0)"
+libs="-lasound $(pkg-config --libs gstreamer-1.0)"
+for t in display audio; do
+  c++ $flags -o "$out/coreelec_${t}_test" "$tests/coreelec_${t}_test.cc" "$shared/coreelec_$t.cc" $libs
+  "$out/coreelec_${t}_test"
+done
