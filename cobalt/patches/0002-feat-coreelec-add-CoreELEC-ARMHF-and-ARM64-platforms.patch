+using ocdm_widevine::AndroidCdm;
+
+namespace {
+
+struct SessionState {
+  std::string id;
+  OpenCDMSessionCallbacks callbacks = {};
+  void *user_data = nullptr;
+  OpenCDMSession *primary = nullptr; // the handle callbacks report
+  std::map<std::string, KeyStatus> keys;
+  // While opencdm_session_update runs: messages held back until the update
+  // ends.
+  bool updating = false;
+  bool update_changed_keys = false;
+  std::vector<std::pair<ocdm_widevine::MessageType, std::string>> held;
+};
+
+KeyStatus ToKeyStatus(ocdm_widevine::KeyStatus status) {
+  switch (status) {
+  case ocdm_widevine::kUsable:
+    return Usable;
+  case ocdm_widevine::kExpired:
+    return Expired;
+  case ocdm_widevine::kOutputRestricted:
+    return OutputRestricted;
+  case ocdm_widevine::kOutputDownscaled:
+    return OutputDownscaled;
+  case ocdm_widevine::kStatusPending:
+    return StatusPending;
+  case ocdm_widevine::kReleased:
+    return Released;
+  default:
+    return InternalError;
+  }
+}
+
+bool IsWidevine(const char *key_system) {
+  std::string name = key_system ? key_system : "";
+  return name == "com.widevine.alpha" || name == "com.youtube.widevine.l3" ||
+         name == "com.widevine";
+}
+
+} // namespace
+
+struct OpenCDMSystem {};
+struct OpenCDMSession {
+  std::shared_ptr<SessionState> state;
+};
+
+namespace {
+
+// Sessions by CDM session ID; turns CDM events into OpenCDM callbacks.
+class Registry : public ocdm_widevine::SessionEvents {
+public:
+  static Registry &Get() {
+    static Registry *registry = new Registry();
+    return *registry;
+  }
+
+  void Add(const std::shared_ptr<SessionState> &state) {
+    std::vector<std::pair<ocdm_widevine::MessageType, std::string>> early;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      sessions_[state->id] = state;
+      early.swap(early_[state->id]);
+      early_.erase(state->id);
+    }
+    // Messages the CDM sent before its session ID was known.
+    for (auto &[type, message] : early) {
+      Deliver(state, type, message);
+    }
+  }
+
+  void Remove(const std::string &id) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    sessions_.erase(id);
+  }
+
+  std::shared_ptr<SessionState> Find(const std::string &id) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = sessions_.find(id);
+    return it == sessions_.end() ? nullptr : it->second;
+  }
+
+  std::shared_ptr<SessionState> FindByKey(const std::string &key) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto &[id, state] : sessions_) {
+      if (state->keys.count(key)) {
+        return state;
+      }
+    }
+    return nullptr;
+  }
+
+  KeyStatus Status(const std::shared_ptr<SessionState> &state,
+                   const std::string &key) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = state->keys.find(key);
+    return it == state->keys.end() ? StatusPending : it->second;
+  }
+
+  // Called by opencdm_destruct_session on the primary handle: no more
+  // callbacks.
+  void Detach(const std::shared_ptr<SessionState> &state) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    state->callbacks = {};
+    state->primary = nullptr;
+  }
+
+  // ocdm_widevine::SessionEvents (on the CDM thread)
+  void OnMessage(const std::string &id, ocdm_widevine::MessageType type,
+                 const std::string &message) override {
+    auto state = Find(id);
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!state) {
+        early_[id].emplace_back(type, message);
+        return;
+      }
+      if (state->updating) {
+        state->held.emplace_back(type, message);
+        return;
+      }
+    }
+    Deliver(state, type, message);
+  }
+
+  // drm_system_ocdm.cc tags every message with the ticket of the operation in
+  // progress and ends an update on keys_updated_callback, as Thunder's OpenCDM
+  // sends it after every update. Widevine answers a service certificate with no
+  // key change but a new license request; sent during the update, that request
+  // would carry the update's ticket, which Cobalt drops. So: hold messages
+  // while the update runs, end it with keys_updated_callback, then send them.
+  void BeginUpdate(const std::shared_ptr<SessionState> &state) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    state->updating = true;
+    state->update_changed_keys = false;
+  }
+
+  void EndUpdate(const std::shared_ptr<SessionState> &state, bool ok) {
+    OpenCDMSessionCallbacks callbacks;
+    OpenCDMSession *handle;
+    bool changed_keys;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      callbacks = state->callbacks;
+      handle = state->primary;
+      changed_keys = state->update_changed_keys;
+    }
+    // A failed update is reported by the caller; a key change already sent
+    // keys_updated.
+    if (ok && !changed_keys && callbacks.keys_updated_callback) {
+      callbacks.keys_updated_callback(handle, state->user_data);
+    }
+    // Messages that arrive meanwhile join the queue, so they keep their order.
+    for (;;) {
+      std::pair<ocdm_widevine::MessageType, std::string> next;
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (state->held.empty()) {
+          state->updating = false;
+          return;
+        }
+        next = std::move(state->held.front());
+        state->held.erase(state->held.begin());
+      }
+      Deliver(state, next.first, next.second);
+    }
+  }
+
+  void OnKeysChange(
+      const std::string &id,
+      const std::vector<std::pair<std::string, ocdm_widevine::KeyStatus>> &keys)
+      override {
+    auto state = Find(id);
+    if (!state) {
+      return;
+    }
+    OpenCDMSessionCallbacks callbacks;
+    OpenCDMSession *handle;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      for (const auto &[key, status] : keys) {
+        state->keys[key] = ToKeyStatus(status);
+      }
+      if (state->updating) {
+        state->update_changed_keys = true;
+      }
+      callbacks = state->callbacks;
+      handle = state->primary;
+    }
+    for (const auto &[key, status] : keys) {
+      if (callbacks.key_update_callback) {
+        callbacks.key_update_callback(
+            handle, state->user_data,
+            reinterpret_cast<const uint8_t *>(key.data()), key.size());
+      }
+    }
+    if (callbacks.keys_updated_callback) {
+      callbacks.keys_updated_callback(handle, state->user_data);
+    }
+  }
+
+  void OnClosed(const std::string &id) override { Remove(id); }
+
+private:
+  void Deliver(const std::shared_ptr<SessionState> &state,
+               ocdm_widevine::MessageType type, const std::string &message) {
+    OpenCDMSessionCallbacks callbacks;
+    OpenCDMSession *handle;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      callbacks = state->callbacks;
+      handle = state->primary;
+    }
+    // drm_system_ocdm.cc reads the EME message type from a "<type>:Type:"
+    // prefix.
+    std::string challenge =
+        std::to_string(static_cast<int>(type)) + ":Type:" + message;
+    if (challenge.size() > UINT16_MAX) {
+      if (callbacks.error_message_callback) {
+        callbacks.error_message_callback(handle, state->user_data,
+                                         "CDM message too long");
+      }
+      return;
+    }
+    if (callbacks.process_challenge_callback) {
+      callbacks.process_challenge_callback(
+          handle, state->user_data, "",
+          reinterpret_cast<const uint8_t *>(challenge.data()),
+          challenge.size());
+    }
+  }
+
+  std::mutex mutex_;
+  std::map<std::string, std::shared_ptr<SessionState>> sessions_;
+  std::map<std::string,
+           std::vector<std::pair<ocdm_widevine::MessageType, std::string>>>
+      early_;
+};
+
+AndroidCdm *Cdm() {
+  AndroidCdm *cdm = AndroidCdm::Get();
+  if (cdm) {
+    cdm->SetEvents(&Registry::Get());
+  }
+  return cdm;
+}
+
+std::string BufferBytes(GstBuffer *buffer) {
+  std::string bytes;
+  if (buffer) {
+    bytes.resize(gst_buffer_get_size(buffer));
+    gst_buffer_extract(buffer, 0, &bytes[0], bytes.size());
+  }
+  return bytes;
+}
+
+} // namespace
+
+extern "C" {
+
+OpenCDMError opencdm_is_type_supported(const char keySystem[], const char[]) {
+  return IsWidevine(keySystem) && Cdm() ? ERROR_NONE
+                                        : ERROR_KEYSYSTEM_NOT_SUPPORTED;
+}
+
+OpenCDMSystem *opencdm_create_system(const char keySystem[]) {
+  return opencdm_is_type_supported(keySystem, "") == ERROR_NONE
+             ? new OpenCDMSystem()
+             : nullptr;
+}
+
+OpenCDMError opencdm_destruct_system(OpenCDMSystem *system) {
+  delete system;
+  return ERROR_NONE;
+}
+
+OpenCDMError opencdm_system_set_server_certificate(OpenCDMSystem *,
+                                                   const uint8_t certificate[],
+                                                   const uint16_t length) {
+  AndroidCdm *cdm = Cdm();
+  return cdm && cdm->SetServerCertificate(std::string(
+                    reinterpret_cast<const char *>(certificate), length))
+             ? ERROR_NONE
+             : ERROR_FAIL;
+}
+
+OpenCDMError
+opencdm_construct_session(OpenCDMSystem *system, const LicenseType,
+                          const char initDataType[], const uint8_t initData[],
+                          const uint16_t initDataLength, const uint8_t[],
+                          const uint16_t, OpenCDMSessionCallbacks *callbacks,
+                          void *userData, OpenCDMSession **session) {
+  AndroidCdm *cdm = Cdm();
+  if (!system || !cdm || !session) {
+    return ERROR_INVALID_ACCESSOR;
+  }
+  std::string type = initDataType ? initDataType : "";
+  ocdm_widevine::InitDataType cdm_type = type == "webm" ? ocdm_widevine::kWebM
+                                         : type == "keyids"
+                                             ? ocdm_widevine::kKeyIds
+                                             : ocdm_widevine::kCenc;
+  auto state = std::make_shared<SessionState>();
+  state->user_data = userData;
+  if (callbacks) {
+    state->callbacks = *callbacks;
+  }
+  auto *handle = new OpenCDMSession{state};
+  state->primary = handle;
+  std::string error;
+  if (!cdm->CreateSession(
+          cdm_type,
+          std::string(reinterpret_cast<const char *>(initData), initDataLength),
+          &state->id, &error)) {
+    delete handle;
+    return ERROR_FAIL;
+  }
+  Registry::Get().Add(state);
+  *session = handle;
+  return ERROR_NONE;
+}
+
+OpenCDMError opencdm_destruct_session(OpenCDMSession *session) {
+  if (!session) {
+    return ERROR_INVALID_SESSION;
+  }
+  if (session->state->primary == session) {
+    Registry::Get().Detach(session->state);
+  }
+  delete session;
+  return ERROR_NONE;
+}
+
+OpenCDMError opencdm_session_close(OpenCDMSession *session) {
+  AndroidCdm *cdm = Cdm();
+  if (!session || !cdm) {
+    return ERROR_INVALID_SESSION;
+  }
+  bool ok = cdm->CloseSession(session->state->id);
+  Registry::Get().Remove(session->state->id);
+  return ok ? ERROR_NONE : ERROR_FAIL;
+}
+
+const char *opencdm_session_id(const OpenCDMSession *session) {
+  return session ? session->state->id.c_str() : "";
+}
+
+OpenCDMError opencdm_session_update(OpenCDMSession *session,
+                                    const uint8_t keyMessage[],
+                                    const uint16_t keyLength) {
+  AndroidCdm *cdm = Cdm();
+  if (!session || !cdm) {
+    return ERROR_INVALID_SESSION;
+  }
+  Registry::Get().BeginUpdate(session->state);
+  bool ok = cdm->UpdateSession(
+      session->state->id,
+      std::string(reinterpret_cast<const char *>(keyMessage), keyLength),
+      nullptr);
+  Registry::Get().EndUpdate(session->state, ok);
+  return ok ? ERROR_NONE : ERROR_FAIL;
+}
+
+KeyStatus opencdm_session_status(const OpenCDMSession *session,
+                                 const uint8_t keyId[], const uint8_t length) {
+  if (!session) {
+    return InternalError;
+  }
+  return Registry::Get().Status(
+      session->state,
+      std::string(reinterpret_cast<const char *>(keyId), length));
+}
+
+OpenCDMSession *opencdm_get_system_session(OpenCDMSystem *,
+                                           const uint8_t keyId[],
+                                           const uint8_t length,
+                                           const uint32_t) {
+  auto state = Registry::Get().FindByKey(
+      std::string(reinterpret_cast<const char *>(keyId), length));
+  return state ? new OpenCDMSession{state} : nullptr; // the caller destructs it
+}
+
+OpenCDMError opencdm_gstreamer_session_decrypt(
+    OpenCDMSession *session, GstBuffer *buffer, GstBuffer *subSample,
+    const uint32_t subSampleCount, GstBuffer *IV, GstBuffer *keyID, uint32_t) {
+  AndroidCdm *cdm = Cdm();
+  if (!session || !cdm || !buffer) {
+    return ERROR_INVALID_SESSION;
+  }
+  // Scheme and pattern come from the protection meta player_internal.cc adds.
+  ocdm_widevine::EncryptionScheme scheme =
+      ocdm_widevine::EncryptionScheme::kCenc;
+  ocdm_widevine::Pattern pattern = {0, 0};
+  if (GstProtectionMeta *meta = gst_buffer_get_protection_meta(buffer)) {
+    const gchar *mode = gst_structure_get_string(meta->info, "cipher-mode");
+    if (mode && strcmp(mode, "cbcs") == 0) {
+      scheme = ocdm_widevine::EncryptionScheme::kCbcs;
+      gst_structure_get_uint(meta->info, "crypt_byte_block",
+                             &pattern.crypt_byte_block);
+      gst_structure_get_uint(meta->info, "skip_byte_block",
+                             &pattern.skip_byte_block);
+    }
+  }
+  // Subsamples: big-endian (uint16 clear, uint32 encrypted) pairs.
+  std::string packed = BufferBytes(subSample);
+  std::vector<ocdm_widevine::SubsampleEntry> subsamples;
+  if (subSampleCount > 65536 || packed.size() != uint64_t(subSampleCount) * 6) {
+    return ERROR_INVALID_DECRYPT_BUFFER;
+  }
+  for (uint32_t i = 0; i < subSampleCount; i++) {
+    const auto *p = reinterpret_cast<const uint8_t *>(packed.data()) + i * 6;
+    subsamples.push_back(
+        {static_cast<uint32_t>(p[0] << 8 | p[1]),
+         static_cast<uint32_t>(p[2]) << 24 | p[3] << 16 | p[4] << 8 | p[5]});
+  }
+  // The player trims an 8-byte cenc IV; the CDM wants 16 bytes.
+  std::string iv = BufferBytes(IV);
+  if (iv.size() != 8 && iv.size() != 16)
+    return ERROR_INVALID_DECRYPT_BUFFER;
+  iv.resize(16, '\0');
+  std::string key = BufferBytes(keyID);
+
+  GstMapInfo map;
+  if (!gst_buffer_map(buffer, &map, GST_MAP_READWRITE)) {
+    return ERROR_INVALID_DECRYPT_BUFFER;
+  }
+  if (subsamples.empty()) {
+    subsamples.push_back({0, static_cast<uint32_t>(map.size)});
+  }
+  ocdm_widevine::InputBuffer input = {};
+  input.data = map.data;
+  input.data_size = map.size;
+  input.encryption_scheme = scheme;
+  input.key_id = reinterpret_cast<const uint8_t *>(key.data());
+  input.key_id_size = key.size();
+  input.iv = reinterpret_cast<const uint8_t *>(iv.data());
+  input.iv_size = iv.size();
+  input.subsamples = subsamples.data();
+  input.num_subsamples = subsamples.size();
+  input.pattern = pattern;
+  std::vector<uint8_t> output;
+  ocdm_widevine::Status status =
+      cdm->Decrypt(session->state->id, input, &output);
+  if (status == ocdm_widevine::kSuccess && output.size() == map.size) {
+    memcpy(map.data, output.data(), output.size());
+  }
+  gst_buffer_unmap(buffer, &map);
+  if (status == ocdm_widevine::kNoKey) {
+    return ERROR_INVALID_SESSION;
+  }
+  return status == ocdm_widevine::kSuccess && output.size() == map.size
+             ? ERROR_NONE
+             : ERROR_INVALID_DECRYPT_BUFFER;
+}
+
+} // extern "C"
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/fake_android_helper.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/fake_android_helper.cc
new file mode 100644
index 00000000000..f09b08ae097
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/fake_android_helper.cc
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "../android_protocol.h"
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <sys/mman.h>
+#include <vector>
+using namespace android_drm;
+
+int main(int argc, char **argv) {
+  if (argc != 3)
+    return 2;
+  int fd = atoi(argv[1]);
+  auto *shared = static_cast<uint8_t *>(mmap(nullptr, 2 * kCapacity,
+                                             PROT_READ | PROT_WRITE, MAP_SHARED,
+                                             atoi(argv[2]), 0));
+  if (shared == MAP_FAILED)
+    return 3;
+  std::map<std::string, std::string> keys;
+  unsigned next = 0;
+  Packet request;
+  while (Receive(fd, &request)) {
+    Packet result, events;
+    uint32_t command = request.Get(), count = 0, status = Ok;
+    if (command == Hello) {
+      if (request.Get() != kVersion)
+        return 4;
+    } else if (command == Open) {
+      request.String();
+      std::string init = request.String(), id = "s" + std::to_string(++next);
+      result.Put(id);
+      events.Put(Message);
+      events.Put(id);
+      events.Put(0);
+      events.Put("challenge:" + init);
+      count = 1;
+    } else if (command == Update) {
+      std::string id = request.String(), response = request.String();
+      if (response == "bad")
+        status = Failed;
+      else if (response == "cert") {
+        events.Put(Message);
+        events.Put(id);
+        events.Put(0);
+        events.Put(std::string("license-request"));
+        count = 1;
+      } else {
+        keys[id] = response;
+        events.Put(Keys);
+        events.Put(id);
+        events.Put(1);
+        events.Put(response);
+        events.Put(0);
+        count = 1;
+      }
+    } else if (command == Certificate) {
+      if (request.String() != "server-cert")
+        status = Failed;
+    } else if (command == Close) {
+      keys.erase(request.String());
+    } else if (command == Decrypt) {
+      std::string id = request.String(), key = request.String(),
+                  iv = request.String();
+      uint32_t scheme = request.Get(), crypt = request.Get(),
+               skip = request.Get();
+      uint32_t size = request.Get(), samples = request.Get();
+      if (size > kCapacity || iv != std::string(8, 7) + std::string(8, '\0') ||
+          (scheme != 1 && scheme != 2) ||
+          (scheme == 2 && (crypt != 1 || skip != 9)))
+        return 5;
+      if (keys[id] != key)
+        status = NoKey;
+      memcpy(shared + kCapacity, shared, size);
+      uint64_t offset = 0;
+      for (uint32_t i = 0; i < samples; ++i) {
+        uint32_t clear = request.Get(), cipher = request.Get();
+        offset += clear;
+        if (offset + cipher > size)
+          return 6;
+        for (uint32_t j = 0; j < cipher; ++j)
+          shared[kCapacity + offset + j] ^= 0x5A;
+        offset += cipher;
+      }
+      if (offset != size)
+        return 7;
+    } else if (command != Poll)
+      return 8;
+    if (!request.Done())
+      return 9;
+    Packet reply;
+    reply.Put(status);
+    reply.data += result.data;
+    reply.Put(count);
+    reply.data += events.data;
+    if (!Send(fd, reply))
+      break;
+  }
+  return 0;
+}
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/ocdm_widevine_test.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/ocdm_widevine_test.cc
new file mode 100644
index 00000000000..0e1a66d4d22
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/ocdm_widevine_test.cc
@@ -0,0 +1,328 @@
+// Copyright 2026 Team CoreELEC (https://coreelec.org)
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Drives libocdm (the OpenCDM API on a Widevine CDM) against
+// tests/fake_android_helper.cc the way the RDK Starboard port does: sessions,
+// license messages, key status, and in-place decryption of GStreamer buffers
+// carrying protection meta. Usage: ocdm_widevine_test
+// /path/to/fake_android_helper
+
+#include "../android_protocol.h"
+#include <gst/gst.h>
+#include <stdlib.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "opencdm/open_cdm.h"
+#include "opencdm/open_cdm_adapter.h"
+
+namespace {
+
+int g_failures = 0;
+
+#define EXPECT(cond)                                                           \
+  do {                                                                         \
+    if (!(cond)) {                                                             \
+      fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);          \
+      g_failures++;                                                            \
+    }                                                                          \
+  } while (0)
+
+struct Events {
+  std::string challenge;
+  std::vector<std::string> updated_keys;
+  int keys_updated = 0;
+  std::string error;
+  std::vector<std::string> order; // "message" and "updated", as they arrived
+};
+
+void OnChallenge(OpenCDMSession *, void *user_data, const char[],
+                 const uint8_t challenge[], const uint16_t length) {
+  static_cast<Events *>(user_data)->challenge.assign(
+      reinterpret_cast<const char *>(challenge), length);
+  static_cast<Events *>(user_data)->order.push_back("message");
+}
+void OnKeyUpdate(OpenCDMSession *, void *user_data, const uint8_t key_id[],
+                 const uint8_t length) {
+  static_cast<Events *>(user_data)->updated_keys.emplace_back(
+      reinterpret_cast<const char *>(key_id), length);
+}
+void OnError(OpenCDMSession *, void *user_data, const char message[]) {
+  static_cast<Events *>(user_data)->error = message;
+}
+void OnKeysUpdated(const OpenCDMSession *, void *user_data) {
+  static_cast<Events *>(user_data)->keys_updated++;
+  static_cast<Events *>(user_data)->order.push_back("updated");
+}
+
+// Waits up to a second for |done| (callbacks arrive on the CDM thread).
+template <typename F> bool WaitFor(F done) {
+  for (int i = 0; i < 100 && !done(); i++) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  return done();
+}
+
+GstBuffer *MakeBytes(const std::vector<uint8_t> &bytes) {
+  GstBuffer *buffer = gst_buffer_new_allocate(nullptr, bytes.size(), nullptr);
+  gst_buffer_fill(buffer, 0, bytes.data(), bytes.size());
+  return buffer;
+}
+
+// A sample as player_internal.cc builds it: protection meta plus separate
+// subsample, IV and key ID buffers.
+struct Sample {
+  GstBuffer *data;
+  GstBuffer *subsamples;
+  GstBuffer *iv;
+  GstBuffer *key;
+  uint32_t subsample_count;
+};
+
+Sample MakeSample(const std::string &key, const char *cipher_mode,
+                  uint32_t crypt, uint32_t skip,
+                  const std::vector<std::pair<uint16_t, uint32_t>> &layout,
+                  size_t size) {
+  std::vector<uint8_t> data(size);
+  for (size_t i = 0; i < size; i++) {
+    data[i] = static_cast<uint8_t>(i);
+  }
+  std::vector<uint8_t> packed;
+  for (const auto &[clear, cipher] : layout) {
+    packed.push_back(clear >> 8);
+    packed.push_back(clear & 0xff);
+    for (int shift = 24; shift >= 0; shift -= 8) {
+      packed.push_back((cipher >> shift) & 0xff);
+    }
+  }
+  Sample s;
+  s.data = MakeBytes(data);
+  s.subsamples = layout.empty() ? nullptr : MakeBytes(packed);
+  s.iv = MakeBytes(
+      std::vector<uint8_t>(8, 7)); // 8-byte cenc IV, as the player trims it
+  s.key = MakeBytes(std::vector<uint8_t>(key.begin(), key.end()));
+  s.subsample_count = layout.size();
+  GstStructure *info = gst_structure_new("application/x-cenc", "cipher-mode",
+                                         G_TYPE_STRING, cipher_mode, nullptr);
+  if (crypt || skip) {
+    gst_structure_set(info, "crypt_byte_block", G_TYPE_UINT, crypt,
+                      "skip_byte_block", G_TYPE_UINT, skip, nullptr);
+  }
+  gst_buffer_add_protection_meta(s.data, info);
+  return s;
+}
+
+std::vector<uint8_t> Bytes(GstBuffer *buffer) {
+  std::vector<uint8_t> out(gst_buffer_get_size(buffer));
+  gst_buffer_extract(buffer, 0, out.data(), out.size());
+  return out;
+}
+
+void Free(Sample &s) {
+  for (GstBuffer *b : {s.data, s.subsamples, s.iv, s.key}) {
+    if (b) {
+      gst_buffer_unref(b);
+    }
+  }
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  if (argc != 2) {
+    fprintf(stderr, "usage: %s fake_android_helper\n", argv[0]);
+    return 2;
+  }
+  gst_init(nullptr, nullptr);
+  int sockets[2];
+  EXPECT(socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) == 0);
+  FILE *memory = tmpfile();
+  EXPECT(memory != nullptr);
+  int memory_fd = fileno(memory);
+  EXPECT(ftruncate(memory_fd, 2 * android_drm::kCapacity) == 0);
+  pid_t helper = fork();
+  if (helper == 0) {
+    close(sockets[0]);
+    std::string fd = std::to_string(sockets[1]),
+                shared = std::to_string(memory_fd);
+    execl(argv[1], argv[1], fd.c_str(), shared.c_str(), nullptr);
+    _exit(127);
+  }
+  close(sockets[1]);
+  setenv("TIZENTUBE_DRM_FD", std::to_string(sockets[0]).c_str(), 1);
+  setenv("TIZENTUBE_DRM_BUFFER_FD", std::to_string(memory_fd).c_str(), 1);
+  // Key systems: YouTube asks for both Widevine names.
+  EXPECT(opencdm_is_type_supported("com.widevine.alpha", "video/mp4") ==
+         ERROR_NONE);
+  EXPECT(opencdm_is_type_supported("com.youtube.widevine.l3", "") ==
+         ERROR_NONE);
+  EXPECT(opencdm_is_type_supported("org.w3.clearkey", "") != ERROR_NONE);
+
+  OpenCDMSystem *system = opencdm_create_system("com.widevine.alpha");
+  EXPECT(system != nullptr);
+
+  const std::string server_cert = "server-cert";
+  EXPECT(opencdm_system_set_server_certificate(
+             system, reinterpret_cast<const uint8_t *>(server_cert.data()),
+             server_cert.size()) == ERROR_NONE);
+
+  // A session's license request reaches the app with its EME type in front.
+  Events events;
+  OpenCDMSessionCallbacks callbacks = {OnChallenge, OnKeyUpdate, OnError,
+                                       OnKeysUpdated};
+  OpenCDMSession *session = nullptr;
+  const std::string pssh = "pssh-data";
+  EXPECT(opencdm_construct_session(
+             system, Temporary, "cenc",
+             reinterpret_cast<const uint8_t *>(pssh.data()), pssh.size(),
+             nullptr, 0, &callbacks, &events, &session) == ERROR_NONE);
+  EXPECT(session != nullptr);
+  EXPECT(std::string(opencdm_session_id(session)) == "s1");
+  EXPECT(WaitFor([&] { return !events.challenge.empty(); }));
+  EXPECT(events.challenge == "0:Type:challenge:pssh-data");
+
+  // The license grants a key: reported, then marked usable.
+  const std::string key = "0123456789abcdef";
+  EXPECT(opencdm_session_update(session,
+                                reinterpret_cast<const uint8_t *>(key.data()),
+                                key.size()) == ERROR_NONE);
+  EXPECT(WaitFor([&] { return events.keys_updated == 1; }));
+  EXPECT(events.updated_keys.size() == 1 && events.updated_keys[0] == key);
+  EXPECT(opencdm_session_status(session,
+                                reinterpret_cast<const uint8_t *>(key.data()),
+                                key.size()) == Usable);
+
+  // Sessions can be found by key ID; the caller owns the returned handle.
+  OpenCDMSession *found = opencdm_get_system_session(
+      system, reinterpret_cast<const uint8_t *>(key.data()), key.size(), 0);
+  EXPECT(found != nullptr);
+  if (found) {
+    EXPECT(std::string(opencdm_session_id(found)) == "s1");
+    EXPECT(opencdm_destruct_session(found) == ERROR_NONE);
+  }
+  const std::string other = "no-such-key-0000";
+  EXPECT(opencdm_get_system_session(
+             system, reinterpret_cast<const uint8_t *>(other.data()),
+             other.size(), 0) == nullptr);
+
+  // A service certificate (YouTube sends one first) changes no keys, but the
+  // update must still end with keys_updated, and only then may the license
+  // request that follows reach the app: drm_system_ocdm.cc tags each message
+  // with the ticket of the open operation, and Cobalt drops a message carrying
+  // the update's ticket.
+  Events cert_events;
+  OpenCDMSessionCallbacks cert_callbacks = {OnChallenge, OnKeyUpdate, OnError,
+                                            OnKeysUpdated};
+  OpenCDMSession *cert_session = nullptr;
+  EXPECT(
+      opencdm_construct_session(system, Temporary, "cenc",
+                                reinterpret_cast<const uint8_t *>(pssh.data()),
+                                pssh.size(), nullptr, 0, &cert_callbacks,
+                                &cert_events, &cert_session) == ERROR_NONE);
+  EXPECT(WaitFor([&] { return cert_events.order.size() == 1; }));
+  const std::string cert = "cert";
+  EXPECT(opencdm_session_update(cert_session,
+                                reinterpret_cast<const uint8_t *>(cert.data()),
+                                cert.size()) == ERROR_NONE);
+  EXPECT(WaitFor([&] { return cert_events.order.size() == 3; }));
+  EXPECT((cert_events.order ==
+          std::vector<std::string>{"message", "updated", "message"}));
+  EXPECT(cert_events.challenge == "0:Type:license-request");
+  EXPECT(cert_events.updated_keys.empty());
+  EXPECT(opencdm_session_close(cert_session) == ERROR_NONE);
+  EXPECT(opencdm_destruct_session(cert_session) == ERROR_NONE);
+
+  // Closing a second session with the same key must not break the first.
+  OpenCDMSession *duplicate = nullptr;
+  EXPECT(opencdm_construct_session(
+             system, Temporary, "cenc",
+             reinterpret_cast<const uint8_t *>(pssh.data()), pssh.size(),
+             nullptr, 0, nullptr, nullptr, &duplicate) == ERROR_NONE);
+  EXPECT(opencdm_session_update(duplicate,
+                                reinterpret_cast<const uint8_t *>(key.data()),
+                                key.size()) == ERROR_NONE);
+  EXPECT(opencdm_session_close(duplicate) == ERROR_NONE);
+  EXPECT(opencdm_destruct_session(duplicate) == ERROR_NONE);
+
+  // A rejected license is an error for the caller.
+  const std::string bad = "bad";
+  EXPECT(opencdm_session_update(session,
+                                reinterpret_cast<const uint8_t *>(bad.data()),
+                                bad.size()) != ERROR_NONE);
+
+  // cenc: only the encrypted subsample ranges change; the 8-byte IV becomes 16.
+  Sample cenc = MakeSample(key, "cenc", 0, 0, {{4, 12}, {8, 40}}, 64);
+  std::vector<uint8_t> before = Bytes(cenc.data);
+  EXPECT(opencdm_gstreamer_session_decrypt(session, cenc.data, cenc.subsamples,
+                                           cenc.subsample_count, cenc.iv,
+                                           cenc.key, 0) == ERROR_NONE);
+  std::vector<uint8_t> after = Bytes(cenc.data);
+  bool ranges_ok = after.size() == before.size();
+  for (size_t i = 0; ranges_ok && i < after.size(); i++) {
+    bool cipher = (i >= 4 && i < 16) || (i >= 24 && i < 64);
+    ranges_ok = after[i] == (cipher ? (before[i] ^ 0x5A) : before[i]);
+  }
+  EXPECT(ranges_ok);
+  Free(cenc);
+
+  // A sample without subsamples is encrypted whole.
+  Sample whole = MakeSample(key, "cenc", 0, 0, {}, 32);
+  before = Bytes(whole.data);
+  EXPECT(opencdm_gstreamer_session_decrypt(session, whole.data, nullptr, 0,
+                                           whole.iv, whole.key,
+                                           0) == ERROR_NONE);
+  after = Bytes(whole.data);
+  EXPECT(after.size() == 32 && after[0] == (before[0] ^ 0x5A) &&
+         after[31] == (before[31] ^ 0x5A));
+  Free(whole);
+
+  // cbcs: scheme and pattern come from the protection meta.
+  Sample cbcs = MakeSample(key, "cbcs", 1, 9, {{16, 32}}, 48);
+  EXPECT(opencdm_gstreamer_session_decrypt(session, cbcs.data, cbcs.subsamples,
+                                           cbcs.subsample_count, cbcs.iv,
+                                           cbcs.key, 0) == ERROR_NONE);
+  Free(cbcs);
+
+  // A key the CDM does not have fails and leaves the data alone.
+  Sample unknown = MakeSample(other, "cenc", 0, 0, {{0, 16}}, 16);
+  before = Bytes(unknown.data);
+  EXPECT(opencdm_gstreamer_session_decrypt(
+             session, unknown.data, unknown.subsamples, unknown.subsample_count,
+             unknown.iv, unknown.key, 0) != ERROR_NONE);
+  EXPECT(Bytes(unknown.data) == before);
+  Free(unknown);
+
+  // Malformed protection metadata fails without changing the sample.
+  Sample malformed = MakeSample(key, "cenc", 0, 0, {{0, 16}}, 32);
+  before = Bytes(malformed.data);
+  EXPECT(opencdm_gstreamer_session_decrypt(
+             session, malformed.data, malformed.subsamples, 1, malformed.iv,
+             malformed.key, 0) != ERROR_NONE);
+  EXPECT(Bytes(malformed.data) == before);
+  Free(malformed);
+
+  EXPECT(opencdm_session_close(session) == ERROR_NONE);
+  EXPECT(opencdm_destruct_session(session) == ERROR_NONE);
+  EXPECT(opencdm_destruct_system(system) == ERROR_NONE);
+
+  shutdown(sockets[0], SHUT_RDWR);
+  close(sockets[0]);
+  int child_status = 0;
+  EXPECT(waitpid(helper, &child_status, 0) == helper && child_status == 0);
+  fclose(memory);
+
+  if (g_failures) {
+    fprintf(stderr, "%d check(s) failed\n", g_failures);
+    return 1;
+  }
+  printf("all ocdm_widevine tests passed\n");
+  return 0;
+}
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/protocol_test.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/protocol_test.cc
new file mode 100644
index 00000000000..cb7207eaa3b
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/tests/protocol_test.cc
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "../android_protocol.h"
+#include <cassert>
+#include <sys/socket.h>
+#include <thread>
+
+int main() {
+  using namespace android_drm;
+  Packet p;
+  p.Put(17);
+  p.Put(std::string("a\0b", 3));
+  assert(p.Get() == 17 && p.String() == std::string("a\0b", 3) && p.Done());
+  p.Get();
+  assert(!p.Done());
+  Packet bad;
+  bad.Put(kMaxPacket + 1);
+  assert(bad.String().empty() && !bad.Done());
+  int sockets[2];
+  assert(socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) == 0);
+  Packet send;
+  send.Put(std::string("payload"));
+  std::thread writer([&] {
+    assert(Send(sockets[0], send));
+    close(sockets[0]);
+  });
+  Packet received;
+  assert(Receive(sockets[1], &received));
+  assert(received.String() == "payload" && received.Done());
+  assert(!Receive(sockets[1], &received));
+  close(sockets[1]);
+  writer.join();
+}
