+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# CoreELEC (Amlogic-ng, armhf) toolchain. The compiler defaults already match the
+# target (armv8-a, hard float, neon-fp-armv8), so no -march/-mfpu flags here.
+
+import("//starboard/build/config/linux/rdk/config_variables.gni")
+import("//cobalt/build/configs/hacks.gni")
+import("//starboard/build/toolchain/cobalt_toolchains.gni")
+import("$rdk_starboard_root/third_party/starboard/rdk/shared/build/rdk_toolchain.gni")
+
+assert(coreelec_toolchain_dir != "",
+       "CoreELEC builds need coreelec_toolchain_dir in args.gn")
+assert(!rdk_build_with_yocto, "CoreELEC builds need rdk_build_with_yocto = false")
+
+_coreelec_toolprefix =
+    "$coreelec_toolchain_dir/bin/${coreelec_target_triple}-"
+_coreelec_cflags = ""
+if (target_cpu == "arm64") {
+  # Match CoreELEC's ARM64 atomic ABI and linker.
+  _coreelec_cflags = "-mno-outline-atomics -fuse-ld=gold"
+}
+
+rdk_gcc_toolchain("starboard") {
+  toolprefix = _coreelec_toolprefix
+  platform_cflags = _coreelec_cflags
+  toolchain_args = {
+    is_starboard = true
+    sysroot = "$rdk_sysroot"
+    build_base_with_cpp17 = true
+    enable_base_tracing = false
+    use_remoteexec = false
+  }
+  propagates_configs = !enable_cobalt_hermetic_hacks
+}
+
+rdk_gcc_toolchain("native_target") {
+  toolprefix = _coreelec_toolprefix
+  platform_cflags = _coreelec_cflags
+  toolchain_args = {
+    is_starboard = false
+    sysroot = "$rdk_sysroot"
+    build_base_with_cpp17 = true
+    enable_base_tracing = false
+    use_remoteexec = false
+  }
+}
