+// Copyright 2026 Team CoreELEC (https://coreelec.org)
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef STARBOARD_EXTENSION_TIZENTUBE_DISPLAY_H_
+#define STARBOARD_EXTENSION_TIZENTUBE_DISPLAY_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define kTizenTubeExtensionDisplayName "dev.tizentube.extension.Display"
+
+// Display control for TizenTube on platforms without Android's StarboardBridge
+// (h5vcc.tizentube.SetFrameRate goes through it).
+typedef struct TizenTubeExtensionDisplayApi {
+  // Name should be the string |kTizenTubeExtensionDisplayName|.
+  const char* name;
+
+  // This specifies the version of the API that is implemented.
+  uint32_t version;
+
+  // The fields below this point were added in version 1 or later.
+
+  // Switches the display to the refresh rate that best fits a video playing at
+  // |frame_rate| frames per second (TizenTube's auto frame rate). The platform
+  // decides which display modes it may use; it keeps the mode when none fits.
+  void (*SetFrameRate)(float frame_rate);
+} TizenTubeExtensionDisplayApi;
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // STARBOARD_EXTENSION_TIZENTUBE_DISPLAY_H_
