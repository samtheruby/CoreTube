+// Copyright 2026 Team CoreELEC (https://coreelec.org)
+// SPDX-License-Identifier: BSD-3-Clause
+
+// The OpenCDM C API the RDK Starboard port uses (drm_system_ocdm.cc,
+// gst_decryptor_ocdm.cc), implemented on the Widevine CDM.
+
+#include <gst/gst.h>
+
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
