--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_gbm.cc
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "coreelec_gbm.h"
+#include <cerrno>
+#include <chrono>
+#include <cstdio>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <memory>
+#include <poll.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+namespace {
+void Flipped(int, unsigned, unsigned, unsigned, void *pending) {
+  *static_cast<bool *>(pending) = false;
+}
+} // namespace
+
+CoreelecGbm::~CoreelecGbm() { Close(); }
+
+bool CoreelecGbm::Open() {
+  if (device_)
+    return true;
+  Close();
+  fd_ = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
+  auto fail = [this] {
+    perror("coreelec-gbm");
+    Close();
+    return false;
+  };
+  if (fd_ < 0 || drmSetMaster(fd_) != 0)
+    return fail();
+  std::unique_ptr<drmModeRes, decltype(&drmModeFreeResources)> resources(
+      drmModeGetResources(fd_), drmModeFreeResources);
+  if (!resources)
+    return fail();
+  for (int i = 0; i < resources->count_connectors && !connector_; ++i) {
+    std::unique_ptr<drmModeConnector, decltype(&drmModeFreeConnector)>
+        connector(drmModeGetConnector(fd_, resources->connectors[i]),
+                  drmModeFreeConnector);
+    if (!connector || connector->connection != DRM_MODE_CONNECTED ||
+        connector->count_modes < 1)
+      continue;
+    std::unique_ptr<drmModeEncoder, decltype(&drmModeFreeEncoder)> encoder(
+        drmModeGetEncoder(fd_, connector->encoder_id), drmModeFreeEncoder);
+    if (!encoder)
+      continue;
+    crtc_ = encoder->crtc_id;
+    if (!crtc_) {
+      for (int j = 0; j < resources->count_crtcs && j < 32; ++j) {
+        if (encoder->possible_crtcs & (1u << j)) {
+          crtc_ = resources->crtcs[j];
+          break;
+        }
+      }
+    }
+    if (!crtc_)
+      continue;
+    connector_ = connector->connector_id;
+    std::unique_ptr<drmModeCrtc, decltype(&drmModeFreeCrtc)> crtc(
+        drmModeGetCrtc(fd_, crtc_), drmModeFreeCrtc);
+    if (crtc && crtc->mode_valid)
+      mode_ = crtc->mode;
+    else {
+      mode_ = connector->modes[0];
+      for (int j = 0; j < connector->count_modes; ++j) {
+        if (connector->modes[j].type & DRM_MODE_TYPE_PREFERRED) {
+          mode_ = connector->modes[j];
+          break;
+        }
+      }
+    }
+  }
+  if (!connector_ || !mode_.hdisplay || !mode_.vdisplay) {
+    errno = ENODEV;
+    return fail();
+  }
+  device_ = gbm_create_device(fd_);
+  if (!device_)
+    return fail();
+  surface_ = gbm_surface_create(device_, mode_.hdisplay, mode_.vdisplay,
+                                GBM_FORMAT_ARGB8888,
+                                GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+  if (!surface_)
+    return fail();
+  fprintf(stderr, "coreelec-gbm: %dx%d mode %s\n", width(), height(),
+          mode_.name);
+  return true;
+}
+
+uint32_t CoreelecGbm::Framebuffer(gbm_bo *buffer) {
+  auto found = framebuffers_.find(buffer);
+  if (found != framebuffers_.end())
+    return found->second;
+  uint32_t handles[4] = {gbm_bo_get_handle(buffer).u32, 0, 0, 0};
+  uint32_t pitches[4] = {gbm_bo_get_stride(buffer), 0, 0, 0};
+  uint32_t offsets[4] = {};
+  uint64_t modifiers[4] = {gbm_bo_get_modifier(buffer), 0, 0, 0};
+  uint32_t id = 0;
+  int result;
+  if (modifiers[0] != DRM_FORMAT_MOD_INVALID &&
+      modifiers[0] != DRM_FORMAT_MOD_LINEAR) {
+    result = drmModeAddFB2WithModifiers(
+        fd_, gbm_bo_get_width(buffer), gbm_bo_get_height(buffer),
+        gbm_bo_get_format(buffer), handles, pitches, offsets, modifiers, &id,
+        DRM_MODE_FB_MODIFIERS);
+  } else {
+    result = drmModeAddFB2(fd_, gbm_bo_get_width(buffer),
+                           gbm_bo_get_height(buffer), gbm_bo_get_format(buffer),
+                           handles, pitches, offsets, &id, 0);
+  }
+  if (result) {
+    perror("coreelec-gbm framebuffer");
+    return 0;
+  }
+  framebuffers_[buffer] = id;
+  return id;
+}
+
+bool CoreelecGbm::Present() {
+  if (!surface_ || pending_)
+    return false;
+  pending_ = gbm_surface_lock_front_buffer(surface_);
+  if (!pending_)
+    return false;
+  uint32_t framebuffer = Framebuffer(pending_);
+  bool ok = framebuffer != 0;
+  if (ok && !active_) {
+    ok = drmModeSetCrtc(fd_, crtc_, framebuffer, 0, 0, &connector_, 1,
+                        &mode_) == 0;
+    active_ = ok;
+    if (ok)
+      fprintf(stderr, "coreelec-gbm: first frame presented\n");
+  } else if (ok) {
+    bool waiting = true;
+    ok = drmModePageFlip(fd_, crtc_, framebuffer, DRM_MODE_PAGE_FLIP_EVENT,
+                         &waiting) == 0;
+    if (ok) {
+      drmEventContext events = {};
+      events.version = 2;
+      events.page_flip_handler = Flipped;
+      auto deadline =
+          std::chrono::steady_clock::now() + std::chrono::seconds(2);
+      while (waiting) {
+        pollfd descriptor = {fd_, POLLIN, 0};
+        int ready = poll(&descriptor, 1, 100);
+        if (ready < 0 && errno == EINTR)
+          continue;
+        if (ready < 0 ||
+            (descriptor.revents & (POLLERR | POLLHUP | POLLNVAL)) ||
+            (ready > 0 && drmHandleEvent(fd_, &events) != 0) ||
+            std::chrono::steady_clock::now() >= deadline) {
+          // Keep both buffers locked until Close disables scanout.
+          fprintf(stderr, "coreelec-gbm: page flip did not complete\n");
+          return false;
+        }
+      }
+    }
+  }
+  if (!ok) {
+    perror("coreelec-gbm present");
+    gbm_surface_release_buffer(surface_, pending_);
+    pending_ = nullptr;
+    return false;
+  }
+  if (front_)
+    gbm_surface_release_buffer(surface_, front_);
+  front_ = pending_;
+  pending_ = nullptr;
+  return true;
+}
+
+void CoreelecGbm::Close() {
+  if (fd_ >= 0 && active_)
+    drmModeSetCrtc(fd_, crtc_, 0, 0, 0, nullptr, 0, nullptr);
+  for (const auto &item : framebuffers_)
+    drmModeRmFB(fd_, item.second);
+  framebuffers_.clear();
+  if (surface_) {
+    if (pending_)
+      gbm_surface_release_buffer(surface_, pending_);
+    if (front_)
+      gbm_surface_release_buffer(surface_, front_);
+    gbm_surface_destroy(surface_);
+  }
+  if (device_)
+    gbm_device_destroy(device_);
+  if (fd_ >= 0)
+    close(fd_);
+  fd_ = -1;
+  connector_ = crtc_ = 0;
+  active_ = false;
+  device_ = nullptr;
+  surface_ = nullptr;
+  front_ = pending_ = nullptr;
+}
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_gbm.h b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_gbm.h
