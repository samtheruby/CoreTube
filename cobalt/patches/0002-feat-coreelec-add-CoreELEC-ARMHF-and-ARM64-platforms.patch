@@ -0,0 +1,14 @@
+#!/bin/sh
+# SPDX-License-Identifier: BSD-3-Clause
+set -eu
+here=$(cd "$(dirname "$0")/.." && pwd)
+out=${1:-$(mktemp -d)}
+flags="-std=c++17 -Wall -Wextra -Werror -fPIC -I$here/include $(pkg-config --cflags gstreamer-1.0)"
+libs="$(pkg-config --libs gstreamer-1.0) -lpthread"
+c++ $flags -shared -o "$out/libocdm.so" "$here/open_cdm.cc" "$here/android_cdm.cc" $libs
+c++ $flags -o "$out/fake_android_helper" "$here/tests/fake_android_helper.cc"
+c++ $flags -o "$out/protocol_test" "$here/tests/protocol_test.cc" -lpthread
+c++ $flags -o "$out/ocdm_widevine_test" "$here/tests/ocdm_widevine_test.cc" \
+  -L"$out" -locdm -Wl,-rpath,"$out" $libs
+"$out/protocol_test"
+"$out/ocdm_widevine_test" "$out/fake_android_helper"
