index 00000000000..c7161d0c8ca
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/android_protocol.h
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#ifndef CORELEC_ANDROID_DRM_PROTOCOL_H_
+#define CORELEC_ANDROID_DRM_PROTOCOL_H_
+
+#include <cstdint>
+#include <errno.h>
+#include <string>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace android_drm {
+constexpr uint32_t kVersion = 1;
+constexpr uint32_t kMaxPacket = 1024 * 1024;
+constexpr uint32_t kCapacity = 16 * 1024 * 1024;
+enum Command : uint32_t {
+  Hello,
+  Open,
+  Update,
+  Close,
+  Certificate,
+  Decrypt,
+  Poll,
+  Provision
+};
+enum Result : uint32_t { Ok, Failed, NoKey, NotProvisioned };
+enum Event : uint32_t { Message, Keys, Closed };
+
+// Control packets are bounded and big-endian; samples use two shared RAM slots.
+class Packet {
+public:
+  std::string data;
+  void Put(uint32_t value) {
+    for (int shift = 24; shift >= 0; shift -= 8)
+      data += char(value >> shift);
+  }
+  void Put(const std::string &value) {
+    Put(value.size());
+    data += value;
+  }
+  uint32_t Get() {
+    if (position_ > data.size() || data.size() - position_ < 4) {
+      valid_ = false;
+      return 0;
+    }
+    uint32_t value = 0;
+    for (int i = 0; i < 4; ++i)
+      value = (value << 8) | uint8_t(data[position_++]);
+    return value;
+  }
+  std::string String() {
+    uint32_t size = Get();
+    if (!valid_ || size > kMaxPacket || size > data.size() - position_) {
+      valid_ = false;
+      return {};
+    }
+    std::string value = data.substr(position_, size);
+    position_ += size;
+    return value;
+  }
+  bool Done() const { return valid_ && position_ == data.size(); }
+  bool Valid() const { return valid_; }
+
+private:
+  size_t position_ = 0;
+  bool valid_ = true;
+};
+
+inline bool Transfer(int fd, void *bytes, size_t size, bool writing) {
+  char *p = static_cast<char *>(bytes);
+  while (size) {
+    ssize_t count =
+        writing ? send(fd, p, size, MSG_NOSIGNAL) : recv(fd, p, size, 0);
+    if (count < 0 && errno == EINTR)
+      continue;
+    if (count <= 0)
+      return false;
+    p += count;
+    size -= count;
+  }
+  return true;
+}
+inline bool Send(int fd, const Packet &packet) {
+  if (packet.data.size() > kMaxPacket)
+    return false;
+  Packet header;
+  header.Put(packet.data.size());
+  return Transfer(fd, &header.data[0], 4, true) &&
+         Transfer(fd, const_cast<char *>(packet.data.data()),
+                  packet.data.size(), true);
+}
+inline bool Receive(int fd, Packet *packet) {
+  Packet header;
+  header.data.resize(4);
+  if (!Transfer(fd, &header.data[0], 4, false))
+    return false;
+  uint32_t size = header.Get();
+  if (size > kMaxPacket || size < 4)
+    return false;
+  *packet = Packet();
+  packet->data.resize(size);
+  return Transfer(fd, &packet->data[0], size, false);
+}
+} // namespace android_drm
+#endif
