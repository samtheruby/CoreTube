index 00000000000..9a76d77a77c
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_audio.cc
@@ -0,0 +1,108 @@
+// Copyright 2026 Team CoreELEC (https://coreelec.org)
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "third_party/starboard/rdk/shared/coreelec_audio.h"
+
+#include <alsa/asoundlib.h>
+#include <gst/gst.h>
+
+#include <cstdlib>
+#include <mutex>
+#include <sstream>
+
+#include "starboard/common/log.h"
+
+namespace third_party::starboard::rdk::shared::coreelec {
+
+Bitstream PassthroughFor(const std::string& list, const std::string& codec) {
+  std::istringstream words(list);
+  std::string word;
+  while (words >> word) {
+    if (word == codec && codec == "ac3")
+      return Bitstream::kAc3;
+    if (word == codec && codec == "eac3")
+      return Bitstream::kEac3;
+  }
+  return Bitstream::kNone;
+}
+
+int SpdifFormatItem(Bitstream bitstream) {
+  switch (bitstream) {
+    case Bitstream::kAc3:
+      return 2;
+    case Bitstream::kEac3:
+      return 4;
+    default:
+      return 0;
+  }
+}
+
+namespace {
+
+std::mutex g_mutex;
+int g_passthrough_players = 0;
+
+// Kodi's CAESinkALSA::aml_configure_simple_control: on AML-AUGESOUND, HDMI takes
+// its audio from S/PDIF B, and both S/PDIF outputs carry the bitstream's format.
+// Cards without a control (older Amlogic sound drivers) skip it.
+void SetSpdifFormat(Bitstream bitstream, bool hdmi) {
+  snd_ctl_t* ctl = nullptr;
+  if (snd_ctl_open(&ctl, "hw:0", 0) < 0) {
+    SB_LOG(WARNING) << "Cannot open the sound card's controls";
+    return;
+  }
+  auto set = [ctl](const char* name, unsigned int item) {
+    snd_ctl_elem_id_t* id;
+    snd_ctl_elem_value_t* value;
+    snd_ctl_elem_id_alloca(&id);
+    snd_ctl_elem_value_alloca(&value);
+    snd_ctl_elem_id_set_interface(id, SND_CTL_ELEM_IFACE_MIXER);
+    snd_ctl_elem_id_set_name(id, name);
+    snd_ctl_elem_value_set_id(value, id);
+    snd_ctl_elem_value_set_enumerated(value, 0, item);
+    if (snd_ctl_elem_write(ctl, value) < 0)
+      SB_LOG(INFO) << "No sound card control '" << name << "'";
+  };
+  if (hdmi)
+    set("Spdif to HDMITX Select", 1);  // Spdif_b
+  set("Audio spdif_b format", SpdifFormatItem(bitstream));
+  set("Audio spdif format", SpdifFormatItem(bitstream));
+  snd_ctl_close(ctl);
+}
+
+std::string Env(const char* name) {
+  const char* value = std::getenv(name);
+  return value ? value : "";
+}
+
+}  // namespace
+
+GstElement* CreatePassthroughSink(const std::string& codec) {
+  Bitstream bitstream = PassthroughFor(Env("TIZENTUBE_PASSTHROUGH"), codec);
+  std::string device = Env("TIZENTUBE_PASSTHROUGH_DEVICE");
+  if (bitstream == Bitstream::kNone || device.empty())
+    return nullptr;
+
+  // alsasink opens compressed audio as "<device>:{AES0 ...}" (non-audio IEC958),
+  // so the device is the bare name the card's ALSA config defines with AES args.
+  GstElement* sink = gst_element_factory_make("alsasink", nullptr);
+  if (!sink) {
+    SB_LOG(WARNING) << "No alsasink; " << codec << " is decoded instead";
+    return nullptr;
+  }
+  g_object_set(G_OBJECT(sink), "device", device.c_str(), nullptr);
+
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_passthrough_players++;
+  SetSpdifFormat(bitstream, device == "hdmi");
+  SB_LOG(INFO) << "Passing " << codec << " through to " << device;
+  return sink;
+}
+
+void ReleasePassthrough() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_passthrough_players > 0 && --g_passthrough_players == 0)
+    SetSpdifFormat(Bitstream::kNone, false);
+}
+
+}  // namespace third_party::starboard::rdk::shared::coreelec
