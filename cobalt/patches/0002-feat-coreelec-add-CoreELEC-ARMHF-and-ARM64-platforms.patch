+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/cdm_thread.h
@@ -0,0 +1,95 @@
+// Copyright 2026 Team CoreELEC (https://coreelec.org)
+// SPDX-License-Identifier: BSD-3-Clause
+
+// One thread that runs every call into the CDM, which is not thread-safe, and
+// the CDM's timers.
+
+#ifndef OCDM_WIDEVINE_CDM_THREAD_H_
+#define OCDM_WIDEVINE_CDM_THREAD_H_
+
+#include <chrono>
+#include <condition_variable>
+#include <functional>
+#include <future>
+#include <map>
+#include <mutex>
+#include <thread>
+
+namespace ocdm_widevine {
+
+class CdmThread {
+ public:
+  using Clock = std::chrono::steady_clock;
+
+  CdmThread() : thread_([this] { Run(); }) {}
+
+  ~CdmThread() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    wake_.notify_one();
+    thread_.join();
+  }
+
+  CdmThread(const CdmThread&) = delete;
+  CdmThread& operator=(const CdmThread&) = delete;
+
+  // Runs |task| on the thread after |delay|.
+  void Post(std::function<void()> task,
+            std::chrono::milliseconds delay = std::chrono::milliseconds(0)) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      tasks_.emplace(Clock::now() + delay, std::move(task));
+    }
+    wake_.notify_one();
+  }
+
+  bool IsCurrent() const { return std::this_thread::get_id() == thread_.get_id(); }
+
+  // Runs |task| on the thread and waits for it; runs it directly when called
+  // from the thread itself (a CDM callback calling back into us).
+  void RunAndWait(const std::function<void()>& task) {
+    if (IsCurrent()) {
+      task();
+      return;
+    }
+    std::promise<void> done;
+    Post([&] {
+      task();
+      done.set_value();
+    });
+    done.get_future().wait();
+  }
+
+ private:
+  void Run() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (!stop_) {
+      if (tasks_.empty()) {
+        wake_.wait(lock);
+        continue;
+      }
+      auto next = tasks_.begin();
+      if (next->first > Clock::now()) {
+        wake_.wait_until(lock, next->first);
+        continue;
+      }
+      std::function<void()> task = std::move(next->second);
+      tasks_.erase(next);
+      lock.unlock();
+      task();
+      lock.lock();
+    }
+  }
+
+  std::mutex mutex_;
+  std::condition_variable wake_;
+  std::multimap<Clock::time_point, std::function<void()>> tasks_;
+  bool stop_ = false;
+  std::thread thread_;  // last: starts once the members above exist
+};
+
+}  // namespace ocdm_widevine
+
+#endif  // OCDM_WIDEVINE_CDM_THREAD_H_
