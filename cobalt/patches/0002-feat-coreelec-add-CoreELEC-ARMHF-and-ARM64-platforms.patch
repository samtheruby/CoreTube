+# OpenCDM ABI backed by the isolated Android Widevine L3 helper.
+import("//starboard/build/config/linux/rdk/config_variables.gni")
+shared_library("ocdm") {
+  sources = [ "cdm_thread.h", "open_cdm.cc", "android_cdm.cc", "android_cdm.h", "android_protocol.h" ]
+  include_dirs = [ "include" ]
+  configs += [ "$rdk_starboard_root/third_party/starboard/rdk/shared:gstreamer" ]
+  libs = [ "pthread" ]
+}
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/android_cdm.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/android_cdm.cc
new file mode 100644
index 00000000000..f386899dc5c
--- /dev/null
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/ocdm_widevine/android_cdm.cc
@@ -0,0 +1,230 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "android_cdm.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+
+namespace ocdm_widevine {
+using namespace android_drm;
+
+static int Descriptor(const char *name) {
+  const char *value = getenv(name);
+  char *end = nullptr;
+  long fd = value ? strtol(value, &end, 10) : -1;
+  return value && *value && !*end && fd >= 3 && fd <= INT32_MAX ? int(fd) : -1;
+}
+AndroidCdm *AndroidCdm::Get() {
+  static AndroidCdm *instance = [] {
+    auto *cdm = new AndroidCdm;
+    if (!cdm->Connect()) {
+      delete cdm;
+      return static_cast<AndroidCdm *>(nullptr);
+    }
+    return cdm;
+  }();
+  return instance;
+}
+bool AndroidCdm::Connect() {
+  int fd = Descriptor("TIZENTUBE_DRM_FD"),
+      memory = Descriptor("TIZENTUBE_DRM_BUFFER_FD");
+  struct stat info;
+  if (fd < 0 || memory < 0 || fstat(memory, &info) || !S_ISREG(info.st_mode) ||
+      info.st_size != 2 * kCapacity)
+    return false;
+  fd_ = dup(fd);
+  if (fd_ < 0)
+    return false;
+  fcntl(fd_, F_SETFD, FD_CLOEXEC);
+  timeval timeout = {30, 0};
+  setsockopt(fd_, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+  setsockopt(fd_, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+  void *mapping = mmap(nullptr, 2 * kCapacity, PROT_READ | PROT_WRITE,
+                       MAP_SHARED, memory, 0);
+  if (mapping == MAP_FAILED) {
+    close(fd_);
+    fd_ = -1;
+    return false;
+  }
+  shared_ = static_cast<uint8_t *>(mapping);
+  Packet request, reply;
+  request.Put(Hello);
+  request.Put(kVersion);
+  bool ok = Call(request, &reply) && reply.Get() == Ok && Events(&reply);
+  if (!ok) {
+    munmap(shared_, 2 * kCapacity);
+    close(fd_);
+    fd_ = -1;
+    return false;
+  }
+  fprintf(stderr, "ocdm: Android Widevine L3 helper connected\n");
+  thread_.Post([this] { Poll(); }, std::chrono::milliseconds(100));
+  return true;
+}
+void AndroidCdm::SetEvents(SessionEvents *events) {
+  thread_.RunAndWait([&] { events_ = events; });
+}
+bool AndroidCdm::Call(const Packet &request, Packet *reply) {
+  if (fd_ < 0)
+    return false;
+  if (Send(fd_, request) && Receive(fd_, reply))
+    return true;
+  fprintf(stderr, "ocdm: Android DRM helper disconnected\n");
+  close(fd_);
+  fd_ = -1;
+  return false;
+}
+bool AndroidCdm::Events(Packet *reply) {
+  uint32_t count = reply->Get();
+  if (count > 4096)
+    return false;
+  for (uint32_t i = 0; i < count && reply->Valid(); ++i) {
+    uint32_t kind = reply->Get();
+    std::string id = reply->String();
+    if (kind == Message) {
+      uint32_t type = reply->Get();
+      std::string bytes = reply->String();
+      if (type > 2 || !reply->Valid())
+        return false;
+      if (events_)
+        events_->OnMessage(id, MessageType(type), bytes);
+    } else if (kind == Keys) {
+      uint32_t size = reply->Get();
+      if (size > 4096)
+        return false;
+      std::vector<std::pair<std::string, KeyStatus>> keys;
+      for (uint32_t j = 0; j < size; ++j) {
+        std::string key = reply->String();
+        uint32_t status = reply->Get();
+        if (!reply->Valid())
+          return false;
+        keys.emplace_back(key,
+                          status <= 4 ? KeyStatus(status) : kInternalError);
+      }
+      if (events_)
+        events_->OnKeysChange(id, keys);
+    } else if (kind == Closed) {
+      if (events_)
+        events_->OnClosed(id);
+    } else
+      return false;
+  }
+  return reply->Done();
+}
+void AndroidCdm::Poll() {
+  if (fd_ < 0)
+    return;
+  Packet request, reply;
+  request.Put(android_drm::Poll);
+  if (!Call(request, &reply) || reply.Get() != Ok || !Events(&reply))
+    return;
+  thread_.Post([this] { Poll(); }, std::chrono::milliseconds(100));
+}
+bool AndroidCdm::CreateSession(InitDataType type, const std::string &init,
+                               std::string *id, std::string *) {
+  bool ok = false;
+  thread_.RunAndWait([&] {
+    Packet request, reply;
+    request.Put(Open);
+    request.Put(std::string(type == kWebM   ? "webm"
+                            : type == kCenc ? "cenc"
+                                            : "keyids"));
+    request.Put(init);
+    if (!Call(request, &reply) || reply.Get() != Ok)
+      return;
+    *id = reply.String();
+    ok = !id->empty() && Events(&reply);
+  });
+  return ok;
+}
+bool AndroidCdm::UpdateSession(const std::string &id,
+                               const std::string &response, std::string *) {
+  bool ok = false;
+  thread_.RunAndWait([&] {
+    Packet request, reply;
+    request.Put(Update);
+    request.Put(id);
+    request.Put(response);
+    if (!Call(request, &reply))
+      return;
+    uint32_t status = reply.Get();
+    ok = Events(&reply) && status == Ok;
+  });
+  return ok;
+}
+bool AndroidCdm::CloseSession(const std::string &id) {
+  bool ok = false;
+  thread_.RunAndWait([&] {
+    Packet request, reply;
+    request.Put(Close);
+    request.Put(id);
+    if (!Call(request, &reply))
+      return;
+    uint32_t status = reply.Get();
+    ok = Events(&reply) && status == Ok;
+  });
+  return ok;
+}
+bool AndroidCdm::SetServerCertificate(const std::string &certificate) {
+  bool ok = false;
+  thread_.RunAndWait([&] {
+    Packet request, reply;
+    request.Put(Certificate);
+    request.Put(certificate);
+    if (!Call(request, &reply))
+      return;
+    uint32_t status = reply.Get();
+    ok = Events(&reply) && status == Ok;
+  });
+  return ok;
+}
+Status AndroidCdm::Decrypt(const std::string &id, const InputBuffer &input,
+                           std::vector<uint8_t> *output) {
+  Status result = kDecryptError;
+  if (!input.data_size || input.data_size > kCapacity ||
+      input.key_id_size != 16 || input.iv_size != 16 || !input.num_subsamples ||
+      input.num_subsamples > 65536)
+    return result;
+  thread_.RunAndWait([&] {
+    std::string key(reinterpret_cast<const char *>(input.key_id),
+                    input.key_id_size);
+    Packet request, reply;
+    request.Put(android_drm::Decrypt);
+    request.Put(id);
+    request.Put(key);
+    request.Put(
+        std::string(reinterpret_cast<const char *>(input.iv), input.iv_size));
+    request.Put(uint32_t(input.encryption_scheme));
+    request.Put(input.pattern.crypt_byte_block);
+    request.Put(input.pattern.skip_byte_block);
+    request.Put(input.data_size);
+    request.Put(input.num_subsamples);
+    uint64_t total = 0;
+    for (uint32_t i = 0; i < input.num_subsamples; ++i) {
+      request.Put(input.subsamples[i].clear_bytes);
+      request.Put(input.subsamples[i].cipher_bytes);
+      total += uint64_t(input.subsamples[i].clear_bytes) +
+               input.subsamples[i].cipher_bytes;
+    }
+    if (total != input.data_size)
+      return;
+    memcpy(shared_, input.data, input.data_size);
+    if (!Call(request, &reply))
+      return;
+    uint32_t status = reply.Get();
+    if (status == Ok) {
+      output->assign(shared_ + kCapacity,
+                     shared_ + kCapacity + input.data_size);
+      result = kSuccess;
+    } else if (status == NoKey)
+      result = kNoKey;
+    if (!Events(&reply)) {
+      output->clear();
+      result = kDecryptError;
+    }
+  });
+  return result;
+}
+} // namespace ocdm_widevine
