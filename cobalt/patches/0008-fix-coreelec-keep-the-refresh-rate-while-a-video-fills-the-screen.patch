diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc
index 26e0b650c96..5ea5a85bbe1 100644
--- a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc
@@ -3,6 +3,8 @@
 
 #include "third_party/starboard/rdk/shared/coreelec_display.h"
 
+#include <algorithm>
+#include <atomic>
 #include <cmath>
 #include <condition_variable>
 #include <cstdio>
@@ -388,7 +390,7 @@ std::optional<ModeSwitch> AutoFrameRate::Choose(const std::string& allowed,
                                                 Clock::time_point now,
                                                 std::string* why) {
   if (!(frame_rate > 0)) {
-    if (original_ && !restore_at_) {
+    if (original_ && !restore_at_ && videos_on_screen_ == 0) {
       restore_at_ = now + kRestoreDelay;
     }
     return std::nullopt;
@@ -420,10 +422,48 @@ std::optional<ModeSwitch> AutoFrameRate::Restore(const std::string& current,
   return back;
 }
 
+void AutoFrameRate::SetVideosOnScreen(int count, Clock::time_point now) {
+  const bool was_on_screen = videos_on_screen_ > 0;
+  videos_on_screen_ = count;
+  if (count > 0) {
+    restore_at_.reset();
+  } else if (was_on_screen && original_ && !restore_at_) {
+    restore_at_ = now + kRestoreDelay;
+  }
+}
+
 void ResetFrameRate() {
   SetFrameRate(0);
 }
 
+bool CoversWindow(int x, int y, int width, int height, int window_width, int window_height) {
+  return window_width > 0 && window_height > 0 && x <= 0 && y <= 0 &&
+         x + width >= window_width && y + height >= window_height;
+}
+
+namespace {
+std::atomic<int> g_window_width{0};
+std::atomic<int> g_window_height{0};
+}  // namespace
+
+void SetWindowSize(int width, int height) {
+  g_window_width = width;
+  g_window_height = height;
+}
+
+bool FillsWindow(int x, int y, int width, int height) {
+  return CoversWindow(x, y, width, height, g_window_width, g_window_height);
+}
+
+void SetVideoOnScreen(bool on_screen) {
+  static int videos = 0;  // guarded by g_frame_rate_mutex
+  std::lock_guard<std::mutex> lock(g_frame_rate_mutex);
+  videos = std::max(0, videos + (on_screen ? 1 : -1));
+  g_frame_rate.SetVideosOnScreen(videos, AutoFrameRate::Clock::now());
+  g_frame_rate_thread.Start();
+  g_frame_rate_wake.notify_all();
+}
+
 void SetModeSetter(ModeSetter setter) {
   std::lock_guard<std::mutex> lock(g_setter_mutex);
   g_setter = std::move(setter);
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.h b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.h
