 .../coreelec/tests/coreelec_display_test.cc   | 32 ++++++++++++++
 .../starboard/rdk/shared/application_rdk.cc   |  6 ++-
 .../starboard/rdk/shared/coreelec_display.cc  | 42 ++++++++++++++++++-
 .../starboard/rdk/shared/coreelec_display.h   | 22 +++++++++-
 .../rdk/shared/player/player_internal.cc      | 15 +++++++
 5 files changed, 114 insertions(+), 3 deletions(-)

diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
index 264cf2beaa9..ccb356dc186 100644
--- a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
@@ -94,6 +94,38 @@ int main() {
   afr.Choose(modes, "1080p24hz", false, caps, 0, t0);
   assert(!afr.Restore("1080p60hz", false, t0 + delay));
 
+  // A full-screen video keeps its rate. YouTube makes the player again for the same
+  // video; the old one going must not take the display back while the new one shows.
+  AutoFrameRate watch;
+  watch.SetVideosOnScreen(1, t0);
+  s = watch.Choose(modes, "1080p60hz", false, caps, 24, t0);
+  assert(s && s->name == "1080p24hz");
+  watch.Choose(modes, "1080p24hz", false, caps, 0, t0 + 1s);       // old player gone
+  watch.SetVideosOnScreen(0, t0 + 1s);
+  assert(watch.restore_time() == t0 + 1s + delay);
+  watch.SetVideosOnScreen(1, t0 + 2s);                              // the new one
+  assert(!watch.restore_time());
+  assert(!watch.Restore("1080p24hz", false, t0 + 2s + 2 * delay));
+  // No rate wanted while a video still shows: nothing until it goes.
+  assert(!watch.Choose(modes, "1080p24hz", false, caps, 0, t0 + 20s));
+  assert(!watch.restore_time());
+  // The last full-screen video goes: back kRestoreDelay later.
+  watch.SetVideosOnScreen(0, t0 + 30s);
+  assert(!watch.Restore("1080p24hz", false, t0 + 30s + delay - 1s));
+  s = watch.Restore("1080p24hz", false, t0 + 30s + delay);
+  assert(s && s->name == "1080p60hz");
+
+  // Full screen: the bounds cover the whole window (the watch page); a home screen
+  // preview is a window inside it.
+  assert(CoversWindow(0, 0, 1920, 1080, 1920, 1080));
+  assert(CoversWindow(-2, -2, 1924, 1084, 1920, 1080));
+  assert(!CoversWindow(100, 100, 640, 360, 1920, 1080));
+  assert(!CoversWindow(0, 0, 1920, 1000, 1920, 1080));
+  assert(!CoversWindow(0, 0, 0, 0, 0, 0));           // no window yet
+  assert(!FillsWindow(0, 0, 1920, 1080));            // window size not known yet
+  SetWindowSize(1920, 1080);
+  assert(FillsWindow(0, 0, 1920, 1080) && !FillsWindow(100, 100, 640, 360));
+
   // The mode for a WxH picture after the display changed (hotplug, another TV).
   std::vector<OutputMode> outputs = {
       {"2160p60hz", 3840, 2160, false, 60}, {"1080i60hz", 1920, 1080, true, 60},
