   // The switch for |frame_rate| (see ChooseModeSwitch); it cancels a pending
   // return. A |frame_rate| of 0 or less means no video wants a rate: the return
-  // to the mode before the first switch is due kRestoreDelay after |now|.
+  // to the mode before the first switch is due kRestoreDelay after |now|, or
+  // kRestoreDelay after the last full-screen video goes (SetVideosOnScreen).
   std::optional<ModeSwitch> Choose(const std::string& allowed,
                                    const std::string& current,
                                    bool current_fractional,
@@ -87,6 +88,11 @@ class AutoFrameRate {
                                    Clock::time_point now,
                                    std::string* why = nullptr);
 
+  // How many full-screen videos are on screen. Each keeps the display's rate (as
+  // a video surface does on Android): it cancels a pending return, and when the
+  // last one goes, the return is due kRestoreDelay after |now|.
+  void SetVideosOnScreen(int count, Clock::time_point now);
+
   // When the return is due; empty when none is pending.
   std::optional<Clock::time_point> restore_time() const { return restore_at_; }
 
@@ -99,12 +105,26 @@ class AutoFrameRate {
  private:
   std::optional<ModeSwitch> original_;
   std::optional<Clock::time_point> restore_at_;
+  int videos_on_screen_ = 0;
 };
 
 // Auto frame rate with nothing playing: the display goes back to its mode from
 // before (Android drops a rate when its video surface goes away).
 void ResetFrameRate();
 
+// A player's video started (true) or stopped (false) filling the screen.
+void SetVideoOnScreen(bool on_screen);
+
+// Whether a video at these bounds covers a |window_width|x|window_height| window.
+bool CoversWindow(int x, int y, int width, int height, int window_width, int window_height);
+
+// The application window's size, for FillsWindow.
+void SetWindowSize(int width, int height);
+
+// Whether a player's video at these bounds fills the application window (false
+// before SetWindowSize).
+bool FillsWindow(int x, int y, int width, int height);
+
 // How a switch reaches the display. Without a setter it is written to
 // /sys/class/display (framebuffer windows); a DRM window, where those writes are
 // ignored, installs one. Returns false when the switch cannot be made.
