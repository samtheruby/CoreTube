+// A display mode switch: the mode name and whether it runs 1000/1001 slower.
+struct ModeSwitch {
+  std::string name;    // "1080p24hz", as DRM names the mode
+  bool fractional = false;
+  std::string suffix;  // kept from the current sysfs mode name ("420")
+};
+
+// The switch that shows |frame_rate| best, from TIZENTUBE_DISPLAY_MODES
+// (|allowed|), the current mode name and 1000/1001 state, and disp_cap's text
+// (the modes the TV takes). Empty when there is nothing to switch; |why| then
+// says why, when given.
+std::optional<ModeSwitch> ChooseModeSwitch(const std::string& allowed,
+                                           const std::string& current,
+                                           bool current_fractional,
+                                           const std::string& display_caps,
+                                           double frame_rate,
+                                           std::string* why = nullptr);
+
+// How a switch reaches the display. Without a setter it is written to
+// /sys/class/display (framebuffer windows); a DRM window, where those writes are
+// ignored, installs one. Returns false when the switch cannot be made.
+using ModeSetter = std::function<bool(const ModeSwitch&)>;
+void SetModeSetter(ModeSetter setter);
+
+// A mode the connected display offers, as DRM lists it.
+struct OutputMode {
+  std::string name;  // Amlogic names DRM modes like the sysfs ones: "1080p24hz"
+  int width;
+  int height;
+  bool interlaced;
+  int rate;
+};
+
+// The mode to show a |width|x|height| picture on after the display changed
+// (plugged in again, another TV): |wanted| when listed, else the progressive
+// mode of that size closest in rate to |wanted| (to 60 Hz without a wish).
+// -1 when the display has no progressive mode of that size.
+int ChooseOutputMode(const std::vector<OutputMode>& modes,
+                     int width,
+                     int height,
+                     const std::string& wanted);
+
 // Device and display properties for Cobalt (resolution, HDR).
 std::unique_ptr<platform::PlatformInterface> CreatePlatformInterface();
 
