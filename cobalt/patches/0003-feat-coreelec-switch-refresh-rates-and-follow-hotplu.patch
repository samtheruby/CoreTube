+void CoreelecGbm::UseModes(const drmModeConnector &connector) {
+  modes_.assign(connector.modes, connector.modes + connector.count_modes);
+  std::vector<std::string> names;
+  for (const auto &mode : modes_) {
+    if (mode.hdisplay == width_ && mode.vdisplay == height_ &&
+        !(mode.flags & DRM_MODE_FLAG_INTERLACE))
+      names.push_back(mode.name);
+  }
+  std::lock_guard<std::mutex> lock(request_mutex_);
+  mode_names_ = std::move(names);
+}
+
+bool CoreelecGbm::RequestMode(const std::string &name, bool fractional) {
+  std::lock_guard<std::mutex> lock(request_mutex_);
+  if ((fractional && !fractional_property_) ||
+      std::find(mode_names_.begin(), mode_names_.end(), name) ==
+          mode_names_.end())
+    return false;
+  request_ = std::make_pair(name, fractional);
+  return true;
+}
+
+bool CoreelecGbm::SetFractional(bool fractional) {
+  if (!fractional_property_)
+    return false;
+  if (drmModeObjectSetProperty(fd_, connector_, DRM_MODE_OBJECT_CONNECTOR,
+                               fractional_property_, fractional ? 1 : 0)) {
+    perror("coreelec-gbm FRAC_RATE_POLICY");
+    return false;
+  }
+  fractional_ = fractional;
+  return true;
+}
+
+void CoreelecGbm::CheckDisplay(bool now) {
+  auto time = std::chrono::steady_clock::now();
+  if (!now && time < next_check_)
+    return;
+  next_check_ = time + std::chrono::seconds(1);
+  // The kernel updates the connector on hotplug; this does not probe again.
+  ConnectorPtr connector(drmModeGetConnectorCurrent(fd_, connector_),
+                         drmModeFreeConnector);
+  if (!connector || connector->connection != DRM_MODE_CONNECTED ||
+      connector->count_modes < 1) {
+    if (connected_) {
+      fprintf(stderr, "coreelec-gbm: display disconnected, waiting\n");
+      connected_ = false;
+      reported_no_mode_ = false;
+      Disable();
+    }
+    return;
+  }
+  UseModes(*connector);
+  std::vector<third_party::starboard::rdk::shared::coreelec::OutputMode>
+      outputs;
+  for (const auto &mode : modes_) {
+    outputs.push_back({mode.name, mode.hdisplay, mode.vdisplay,
+                       (mode.flags & DRM_MODE_FLAG_INTERLACE) != 0,
+                       static_cast<int>(mode.vrefresh)});
+  }
+  int chosen = third_party::starboard::rdk::shared::coreelec::ChooseOutputMode(
+      outputs, width_, height_, mode_.name);
+  if (chosen < 0) {
+    if (!reported_no_mode_)
+      fprintf(stderr, "coreelec-gbm: the display has no %dx%d mode, waiting\n",
+              width_, height_);
+    reported_no_mode_ = true;
+    if (connected_) {
+      connected_ = false;
+      Disable();
+    }
+    return;
+  }
+  const drmModeModeInfo &mode = modes_[chosen];
+  if (!connected_ || strcmp(mode.name, mode_.name) != 0) {
+    fprintf(stderr, "coreelec-gbm: display %s, showing %s\n",
+            connected_ ? "changed" : "back", mode.name);
+    mode_ = mode;
+    active_ = false; // the next frame sets the mode
+  }
+  connected_ = true;
+  reported_no_mode_ = false;
+}
