+std::optional<ModeSwitch> ChooseModeSwitch(const std::string& allowed,
+                                           const std::string& current_name,
+                                           bool current_fractional,
+                                           const std::string& display_caps,
+                                           double frame_rate,
+                                           std::string* why) {
+  auto explain = [why](const std::string& text) {
+    if (why) {
+      *why = text;
+    }
+    return std::nullopt;
+  };
+  if (!(frame_rate > 0)) {
+    return std::nullopt;
+  }
+  auto current = ParseMode(current_name);
+  if (allowed.empty() || !current || current->interlaced) {
+    return explain("no display modes to switch to");
+  }
+  double rate = ChooseRefreshRate(ParseAllowedModes(allowed), current->width,
+                                  current->height, frame_rate);
+  if (rate <= 0) {
+    std::ostringstream text;
+    text << "no allowed mode fits " << frame_rate << " fps at " << current->width
+         << "x" << current->height;
+    return explain(text.str());
+  }
+  int whole = static_cast<int>(std::lround(rate));
+  bool fractional = std::fabs(rate - whole) > 0.01;
+  if (std::fabs(ActualRate(whole, fractional) -
+                ActualRate(current->rate, current_fractional)) < 0.01) {
+    return std::nullopt;
+  }
+  ModeSwitch target{current->prefix + std::to_string(whole) + "hz", fractional,
+                    current->suffix};
+  if (!DisplayTakes(display_caps, target.name)) {
+    return explain("the TV does not list " + target.name);
+  }
+  return target;
+}
+
+void SetModeSetter(ModeSetter setter) {
+  std::lock_guard<std::mutex> lock(g_setter_mutex);
+  g_setter = std::move(setter);
+}
+
+int ChooseOutputMode(const std::vector<OutputMode>& modes,
+                     int width,
+                     int height,
+                     const std::string& wanted) {
+  auto wish = ParseMode(wanted);
+  int wanted_rate = wish ? wish->rate : 60;
+  int best = -1;
+  for (size_t i = 0; i < modes.size(); ++i) {
+    const OutputMode& mode = modes[i];
+    if (mode.width != width || mode.height != height || mode.interlaced) {
+      continue;
+    }
+    if (mode.name == wanted) {
+      return static_cast<int>(i);
+    }
+    if (best < 0 || std::abs(mode.rate - wanted_rate) <
+                        std::abs(modes[best].rate - wanted_rate)) {
+      best = static_cast<int>(i);
+    }
+  }
+  return best;
+}
