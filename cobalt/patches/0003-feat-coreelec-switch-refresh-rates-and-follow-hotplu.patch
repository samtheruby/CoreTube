index 66e9bbca4e2..24da3fefaea 100644
--- a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
@@ -39,6 +39,35 @@ int main() {
   // 24 fps without a 24 Hz mode falls back to 23.976 (0.1% off), not to 60.
   auto no24 = ParseAllowedModes("3840x2160@23.976 3840x2160@60");
   assert(near(ChooseRefreshRate(no24, 3840, 2160, 24), 23.976));
+
+  // The switch auto frame rate asks for: mode name and 1000/1001 flag.
+  const std::string modes = "1920x1080@60 1920x1080@59.94 1920x1080@24 1920x1080@23.976";
+  const std::string caps = "1080p60hz*\n1080p24hz\n1080i60hz\n2160p60hz\n";
+  auto s = ChooseModeSwitch(modes, "1080p60hz", false, caps, 23.976);
+  assert(s && s->name == "1080p24hz" && s->fractional);
+  s = ChooseModeSwitch(modes, "1080p60hz", false, caps, 24);
+  assert(s && s->name == "1080p24hz" && !s->fractional);
+  s = ChooseModeSwitch(modes, "1080p24hz", true, caps, 59.94);
+  assert(s && s->name == "1080p60hz" && s->fractional);
+  assert(!ChooseModeSwitch(modes, "1080p60hz", false, caps, 60));          // already there
+  assert(!ChooseModeSwitch(modes, "1080p24hz", true, caps, 23.976));       // already there
+  assert(!ChooseModeSwitch(modes, "1080p60hz", false, "1080p60hz\n", 24)); // TV lacks 24 Hz
+  assert(!ChooseModeSwitch("", "1080p60hz", false, caps, 24));             // no allowed modes
+  assert(!ChooseModeSwitch(modes, "1080i60hz", false, caps, 24));          // interlaced now
+  assert(!ChooseModeSwitch(modes, "1080p60hz", false, caps, 0));
+
+  // The mode for a WxH picture after the display changed (hotplug, another TV).
+  std::vector<OutputMode> outputs = {
+      {"2160p60hz", 3840, 2160, false, 60}, {"1080i60hz", 1920, 1080, true, 60},
+      {"1080p50hz", 1920, 1080, false, 50}, {"1080p24hz", 1920, 1080, false, 24},
+      {"1080p60hz", 1920, 1080, false, 60}};
+  assert(ChooseOutputMode(outputs, 1920, 1080, "1080p24hz") == 3);  // still listed
+  assert(ChooseOutputMode(outputs, 1920, 1080, "1080p30hz") == 3);  // closest rate: 24
+  assert(ChooseOutputMode(outputs, 1920, 1080, "") == 4);           // no wish: 60 Hz
+  std::vector<OutputMode> other_tv = {{"1080i60hz", 1920, 1080, true, 60},
+                                      {"2160p60hz", 3840, 2160, false, 60}};
+  assert(ChooseOutputMode(other_tv, 1920, 1080, "1080p60hz") == -1);  // no progressive 1080
+  assert(ChooseOutputMode({}, 1920, 1080, "1080p60hz") == -1);
   std::cout << "all display tests passed\n";
   return 0;
 }
