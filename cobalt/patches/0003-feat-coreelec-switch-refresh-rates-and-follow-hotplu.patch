+void CoreelecGbm::Disable() {
+  if (fd_ >= 0 && active_)
+    drmModeSetCrtc(fd_, crtc_, 0, 0, 0, nullptr, 0, nullptr);
+  active_ = false;
+  // Drop a flip event that may still arrive for the old scanout.
+  drmEventContext events = {};
+  events.version = 2;
+  events.page_flip_handler = Flipped;
+  pollfd descriptor = {fd_, POLLIN, 0};
+  while (fd_ >= 0 && poll(&descriptor, 1, 0) > 0 && (descriptor.revents & POLLIN) &&
+         drmHandleEvent(fd_, &events) == 0) {
+  }
+  flip_waiting_ = false;
+  if (surface_) {
+    if (pending_)
+      gbm_surface_release_buffer(surface_, pending_);
+    if (front_)
+      gbm_surface_release_buffer(surface_, front_);
+  }
+  pending_ = front_ = nullptr;
+}
+
 bool CoreelecGbm::Present() {
   if (!surface_ || pending_)
     return false;
+  CheckDisplay(false);
   pending_ = gbm_surface_lock_front_buffer(surface_);
   if (!pending_)
     return false;
