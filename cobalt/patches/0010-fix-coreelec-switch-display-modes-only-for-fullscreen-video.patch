Subject: [PATCH] fix(coreelec): switch display modes only for fullscreen video

Preview frame-rate requests bypassed the fullscreen tracking that already
protected restoration. Keep the latest request, but select a display mode
only while a video fills the application window. Replay a deferred request
when fullscreen bounds arrive, under the same switch mutex.

Preview requests after fullscreen playback cannot cancel its delayed return
to the original mode. Test previews, both request/bounds orders, cancelled
requests, fractional rates and restoration.

diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
index ccb356dc186..5e9e816e9b1 100644
--- a/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/coreelec/tests/coreelec_display_test.cc
@@ -62,21 +62,47 @@ int main() {
   using namespace std::chrono_literals;
   const auto t0 = AutoFrameRate::Clock::time_point{};
   const auto delay = AutoFrameRate::kRestoreDelay;
+  // Preview cards must never request an HDMI mode switch.
+  AutoFrameRate preview;
+  assert(!preview.Choose(modes, "1080p60hz", false, caps, 24, t0));
+  assert(!preview.restore_time());
+  // The request can precede the bounds; entering fullscreen applies it then.
+  preview.SetVideosOnScreen(1, t0 + 1s);
+  s = preview.Choose(modes, "1080p60hz", false, caps, preview.frame_rate(),
+                     t0 + 1s);
+  assert(s && s->name == "1080p24hz" && !s->fractional);
+  // Preview requests after leaving fullscreen neither switch nor delay
+  // restoration.
+  preview.SetVideosOnScreen(0, t0 + 2s);
+  assert(!preview.Choose(modes, "1080p24hz", false, caps, 59.94, t0 + 3s));
+  assert(preview.restore_time() == t0 + 2s + delay);
+  s = preview.Restore("1080p24hz", false, t0 + 2s + delay);
+  assert(s && s->name == "1080p60hz" && !s->fractional);
+  // A stopped preview must not leave a request to replay on a later video.
+  preview.Choose(modes, "1080p60hz", false, caps, 0, t0 + 10s);
+  preview.SetVideosOnScreen(1, t0 + 11s);
+  assert(!preview.Choose(modes, "1080p60hz", false, caps, preview.frame_rate(),
+                         t0 + 11s));
+  assert(!preview.restore_time());
   AutoFrameRate afr;
   assert(!afr.Choose(modes, "1080p60hz", false, caps, 0, t0));           // nothing to undo
   assert(!afr.restore_time());
+  afr.SetVideosOnScreen(1, t0);
   s = afr.Choose(modes, "1080p60hz", false, caps, 24, t0);
   assert(s && s->name == "1080p24hz" && !s->fractional);
   s = afr.Choose(modes, "1080p24hz", false, caps, 23.976, t0);
   assert(s && s->name == "1080p24hz" && s->fractional);
+  afr.SetVideosOnScreen(0, t0);
   assert(!afr.Choose(modes, "1080p24hz", true, caps, 0, t0));            // no switch yet
   assert(afr.restore_time() == t0 + delay);
   assert(!afr.Restore("1080p24hz", true, t0 + delay - 1s));              // not due
   // The next video, at the same rate, before the delay ends: no switch at all.
+  afr.SetVideosOnScreen(1, t0 + 2s);
   assert(!afr.Choose(modes, "1080p24hz", true, caps, 23.976, t0 + 2s));
   assert(!afr.restore_time());
   assert(!afr.Restore("1080p24hz", true, t0 + 2 * delay));               // cancelled
   // No video for the whole delay: back to 60 Hz.
+  afr.SetVideosOnScreen(0, t0 + 3s);
   assert(!afr.Choose(modes, "1080p24hz", true, caps, 0, t0 + 3s));
   s = afr.Restore("1080p24hz", true, t0 + 3s + delay);
   assert(s && s->name == "1080p60hz" && !s->fractional && s->suffix.empty());
@@ -84,13 +110,17 @@ int main() {
   assert(!afr.Choose(modes, "1080p60hz", false, caps, 0, t0 + 20s));     // nothing left to undo
   assert(!afr.restore_time());
   // A 59.94 Hz start, kept with its suffix.
+  afr.SetVideosOnScreen(1, t0);
   s = afr.Choose(modes, "1080p60hz420", true, caps, 24, t0);
   assert(s && s->name == "1080p24hz");
+  afr.SetVideosOnScreen(0, t0);
   afr.Choose(modes, "1080p24hz420", false, caps, 0, t0);
   s = afr.Restore("1080p24hz420", false, t0 + delay);
   assert(s && s->name == "1080p60hz" && s->fractional && s->suffix == "420");
   // Someone else already put the original mode back: nothing to switch.
+  afr.SetVideosOnScreen(1, t0);
   afr.Choose(modes, "1080p60hz", false, caps, 24, t0);
+  afr.SetVideosOnScreen(0, t0);
   afr.Choose(modes, "1080p24hz", false, caps, 0, t0);
   assert(!afr.Restore("1080p60hz", false, t0 + delay));
 
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc
index 5ea5a85bbe1..9afe29ecc7b 100644
--- a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.cc
@@ -161,8 +161,8 @@ class FrameRateThread {
 };
 FrameRateThread g_frame_rate_thread;
 
-void SetFrameRate(float frame_rate) {
-  std::lock_guard<std::mutex> lock(g_frame_rate_mutex);
+// Called with g_frame_rate_mutex held, including when fullscreen bounds arrive.
+void SetFrameRateLocked(double frame_rate) {
   const char* allowed = getenv("TIZENTUBE_DISPLAY_MODES");
   std::string why;
   auto target = g_frame_rate.Choose(allowed ? allowed : "", ReadFile(kModePath),
@@ -180,6 +180,11 @@ void SetFrameRate(float frame_rate) {
   g_frame_rate_wake.notify_all();
 }
 
+void SetFrameRate(float frame_rate) {
+  std::lock_guard<std::mutex> lock(g_frame_rate_mutex);
+  SetFrameRateLocked(frame_rate);
+}
+
 const TizenTubeExtensionDisplayApi kDisplayApi = {
     kTizenTubeExtensionDisplayName,
     1,
@@ -389,12 +394,16 @@ std::optional<ModeSwitch> AutoFrameRate::Choose(const std::string& allowed,
                                                 double frame_rate,
                                                 Clock::time_point now,
                                                 std::string* why) {
+  frame_rate_ = frame_rate;
   if (!(frame_rate > 0)) {
     if (original_ && !restore_at_ && videos_on_screen_ == 0) {
       restore_at_ = now + kRestoreDelay;
     }
     return std::nullopt;
   }
+  if (videos_on_screen_ == 0) {
+    return std::nullopt;
+  }
   restore_at_.reset();
   auto target = ChooseModeSwitch(allowed, current, current_fractional,
                                  display_caps, frame_rate, why);
@@ -460,6 +469,9 @@ void SetVideoOnScreen(bool on_screen) {
   std::lock_guard<std::mutex> lock(g_frame_rate_mutex);
   videos = std::max(0, videos + (on_screen ? 1 : -1));
   g_frame_rate.SetVideosOnScreen(videos, AutoFrameRate::Clock::now());
+  if (on_screen) {
+    SetFrameRateLocked(g_frame_rate.frame_rate());
+  }
   g_frame_rate_thread.Start();
   g_frame_rate_wake.notify_all();
 }
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.h b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.h
index 18e5b3fb332..f0b2cfa5921 100644
--- a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.h
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/coreelec_display.h
@@ -76,10 +76,11 @@ class AutoFrameRate {
   // video usually wants the same rate, and each switch blanks the TV.
   static constexpr std::chrono::seconds kRestoreDelay{5};
 
-  // The switch for |frame_rate| (see ChooseModeSwitch); it cancels a pending
-  // return. A |frame_rate| of 0 or less means no video wants a rate: the return
-  // to the mode before the first switch is due kRestoreDelay after |now|, or
-  // kRestoreDelay after the last full-screen video goes (SetVideosOnScreen).
+  // The switch for |frame_rate| (see ChooseModeSwitch), only while a video
+  // fills the screen; only then does it cancel a pending return. A |frame_rate|
+  // of 0 or less means no video wants a rate: the return to the mode before the
+  // first switch is due kRestoreDelay after |now|, or kRestoreDelay after the
+  // last full-screen video goes (SetVideosOnScreen).
   std::optional<ModeSwitch> Choose(const std::string& allowed,
                                    const std::string& current,
                                    bool current_fractional,
@@ -88,6 +89,9 @@ class AutoFrameRate {
                                    Clock::time_point now,
                                    std::string* why = nullptr);
 
+  // Replay the latest request when fullscreen bounds arrive after the rate.
+  double frame_rate() const { return frame_rate_; }
+
   // How many full-screen videos are on screen. Each keeps the display's rate (as
   // a video surface does on Android): it cancels a pending return, and when the
   // last one goes, the return is due kRestoreDelay after |now|.
@@ -106,6 +110,7 @@ class AutoFrameRate {
   std::optional<ModeSwitch> original_;
   std::optional<Clock::time_point> restore_at_;
   int videos_on_screen_ = 0;
+  double frame_rate_ = 0;
 };
 
 // Auto frame rate with nothing playing: the display goes back to its mode from
